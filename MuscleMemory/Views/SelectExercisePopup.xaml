<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:models="clr-namespace:MuscleMemory.Models"
               xmlns:controls="clr-namespace:MuscleMemory.Controls"
               xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
               x:Class="MuscleMemory.Views.SelectExercisePopup"
               x:DataType="viewmodels:SelectExerciseViewModel">

    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}" Padding="15" WidthRequest="320" HeightRequest="500" Shadow="{StaticResource CardShadow}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto, Auto, *">
            <Label Grid.Row="0" Text="Select Exercise" FontFamily="LilitaOne" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" HorizontalOptions="Center" Margin="0,0,0,15"/>

            <Border Grid.Row="1" Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" Padding="10,0" Margin="0,0,0,15" BackgroundColor="Transparent" Shadow="{StaticResource CardShadow}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Picker Title="Filter by Muscle Group"
                        ItemsSource="{Binding MuscleGroupFilters}"
                        SelectedItem="{Binding SelectedMuscleGroupFilter}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                        TitleColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                        FontFamily="LilitaOne" />
            </Border>

            <CollectionView Grid.Row="2" ItemsSource="{Binding FilteredExercises}" SelectionMode="Single" SelectedItem="{Binding SelectedExercise}" SelectionChangedCommand="{Binding ConfirmSelectionCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Exercise">
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontFamily="LilitaOne" FontSize="18"/>
                                <HorizontalStackLayout Spacing="8">
                                    <controls:Chip Text="{Binding TargetMuscleGroup}" />
                                    <controls:Chip Text="{Binding Equipment}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>
</toolkit:Popup>
