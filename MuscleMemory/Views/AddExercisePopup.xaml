<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="MuscleMemory.Views.AddExercisePopup">

    <Border Stroke="{StaticResource PrimaryRed}" 
            StrokeThickness="2" 
            BackgroundColor="{StaticResource SolidWhite}"
            Padding="20,30,20,20"
            WidthRequest="300">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="30">

            <Border Stroke="{StaticResource TranslucentBlack}" StrokeThickness="1" Padding="15,5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="ExerciseNameEntry"
                       Placeholder="Exercise name"
                       PlaceholderColor="{StaticResource TranslucentBlack}"
                       TextColor="{StaticResource SolidBlack}"
                       FontSize="18" 
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Button Grid.Column="0" 
                        Text="Cancel"
                        Clicked="OnCancelClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource SolidBlack}"
                        FontAttributes="Bold"
                        FontSize="18"/>

                <Button Grid.Column="1" 
                        Text="Add"
                        Clicked="OnAddClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryRed}"
                        FontAttributes="Bold"
                        FontSize="18"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>