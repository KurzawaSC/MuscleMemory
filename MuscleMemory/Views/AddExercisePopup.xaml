<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
               x:Class="MuscleMemory.Views.AddExercisePopup"
               x:DataType="viewmodels:AddEditExerciseViewModel">

    <Border Stroke="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" 
            StrokeThickness="2" 
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}"
            Padding="20,30,20,20"
            WidthRequest="300" Shadow="{StaticResource CardShadow}">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="30">

            <Border Style="{StaticResource FormField}">
                <Entry Text="{Binding Name}"
                       Placeholder="Exercise name"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       FontSize="18" 
                       FontFamily="LilitaOne"
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <Border Style="{StaticResource FormField}">
                <Picker Title="Target Muscle Group"
                        ItemsSource="{Binding MuscleGroups}"
                        SelectedItem="{Binding SelectedMuscleGroup}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                        TitleColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                        FontFamily="LilitaOne" />
            </Border>

            <Border Style="{StaticResource FormField}">
                <Picker Title="Equipment"
                        ItemsSource="{Binding EquipmentTypes}"
                        SelectedItem="{Binding SelectedEquipment}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                        TitleColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                        FontFamily="LilitaOne" />
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Button Grid.Column="0" 
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                        FontFamily="LilitaOne"
                        FontSize="18"/>

                <Button Grid.Column="1" 
                        Text="Add"
                        Command="{Binding ConfirmCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                        FontFamily="LilitaOne"
                        FontSize="18"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
