<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
               xmlns:models="clr-namespace:MuscleMemory.Models"
               xmlns:controls="clr-namespace:MuscleMemory.Controls"
               x:Class="MuscleMemory.Views.AddExercisePopup"
               x:DataType="viewmodels:AddEditExerciseViewModel">

    <Border Stroke="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" 
            StrokeThickness="2" 
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
            Padding="20,30,20,20"
            WidthRequest="300" Shadow="{StaticResource CardShadow}">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="30">

            <Border Style="{StaticResource FormField}">
                <Entry Text="{Binding Name}"
                       Placeholder="Exercise name"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
                       TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                       FontSize="18" 
                       ClearButtonVisibility="WhileEditing"/>
            </Border>

            <Border Style="{StaticResource FormField}">
                <Picker Title="Target Muscle Group"
                        ItemsSource="{Binding MuscleGroups}"
                        ItemDisplayBinding="{Binding ., x:DataType=models:MuscleGroup, Converter={StaticResource EnumDisplayNameConverter}}"
                        SelectedItem="{Binding SelectedMuscleGroup}"
                        TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                        TitleColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
 />
            </Border>

            <Border Style="{StaticResource FormField}">
                <Picker Title="Equipment"
                        ItemsSource="{Binding EquipmentTypes}"
                        ItemDisplayBinding="{Binding ., x:DataType=models:EquipmentType, Converter={StaticResource EnumDisplayNameConverter}}"
                        SelectedItem="{Binding SelectedEquipment}"
                        TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                        TitleColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
 />
            </Border>

            <controls:PopupActionBar ConfirmText="Add" CancelCommand="{Binding CancelCommand}" ConfirmCommand="{Binding ConfirmCommand}" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
