<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
                             xmlns:controls="clr-namespace:MuscleMemory.Controls"
                             xmlns:constants="clr-namespace:MuscleMemory.Constants"
                             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                             xmlns:markup="clr-namespace:MuscleMemory.Markup"
                             x:Name="PageRoot"
                             x:Class="MuscleMemory.Views.AddEditWorkoutPage"
                             x:DataType="viewmodels:AddEditWorkoutViewModel"
                             BackCommand="{Binding NavigateBackCommand}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding BindingContext.StartGuardingUnsavedChangesCommand, Source={x:Reference PageRoot}}" />
        <toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding BindingContext.StopGuardingUnsavedChangesCommand, Source={x:Reference PageRoot}}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <controls:NavigationHeader Title="{Binding HeaderTitle}" BackCommand="{Binding NavigateBackCommand}" />

        <VerticalStackLayout Grid.Row="1" Padding="{markup:Gutter Top=14}" Spacing="6">
            <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.LabelWorkoutName}" />
            <controls:TextField FieldHeight="52"
                                IsEnabled="{Binding IsEditable}"
                                Text="{Binding WorkoutName}"
                                MaxLength="{x:Static constants:DomainDefaults.MaxNameLength}"
                                Placeholder="{x:Static constants:UiText.PlaceholderWorkoutName}" />
        </VerticalStackLayout>

        <controls:EmptyState Grid.Row="2"
                             Spacing="14"
                             Detail="{x:Static constants:UiText.EmptyWorkoutEditor}"
                             ActionText="{x:Static constants:UiText.ButtonAddExercise}"
                             ActionStyle="{StaticResource AccentOutlineButton}"
                             ActionCommand="{Binding AddExerciseCommand}"
                             IsVisible="{Binding IsEmptyHintVisible}">
            <controls:EmptyState.Icon>
                <Border Style="{StaticResource DashedOutline}"
                        WidthRequest="80"
                        HeightRequest="80"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource TileRadius}" />
                    </Border.StrokeShape>
                    <Label Style="{StaticResource LargeGlyphLabel}"
                           Text="+"
                           TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </controls:EmptyState.Icon>
        </controls:EmptyState>

        <controls:EmptyState Grid.Row="2"
                             Message="{x:Static constants:UiText.LoadingText}"
                             IsVisible="{Binding IsLoading}" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Exercises}"
                        Margin="{markup:Gutter Top=16}"
                        Header="{Binding .}"
                        Footer="{Binding .}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource CardSpacing}" />
            </CollectionView.ItemsLayout>
            <CollectionView.HeaderTemplate>
                <DataTemplate x:DataType="viewmodels:AddEditWorkoutViewModel">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Border Style="{StaticResource SurfaceCard}" Padding="14,10">
                                <VerticalStackLayout>
                                    <Label Style="{StaticResource ValueLabel}" Text="{Binding ExerciseCount}" />
                                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding ExerciseCountCaption}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="14,10">
                                <VerticalStackLayout>
                                    <Label Style="{StaticResource ValueLabel}" Text="{Binding TotalSets}" />
                                    <Label Style="{StaticResource CaptionLabel}" Text="{Binding TotalSetsCaption}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.HeaderExercises}" VerticalOptions="Center" />
                            <controls:TappableButton Grid.Column="1"
                                                     Style="{StaticResource SmallTextButton}"
                                                     Text="{x:Static constants:UiText.ButtonAddInline}"
                                                     Command="{Binding AddExerciseCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.HeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:WorkoutExerciseItem">
                    <Border Style="{StaticResource SurfaceCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddEditWorkoutViewModel}}, Path=EditExerciseCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <Label Style="{StaticResource TitleLabel}"
                                       Text="{Binding ExerciseName}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <controls:Chip Grid.Column="1" Text="{x:Static constants:UiText.ButtonEdit}" VerticalOptions="Center" />
                            </Grid>
                            <HorizontalStackLayout Spacing="6">
                                <controls:Chip>
                                    <controls:Chip.Text>
                                        <MultiBinding StringFormat="{x:Static constants:UiText.SetsByRepsFormat}">
                                            <Binding Path="Sets" />
                                            <Binding Path="Reps" />
                                        </MultiBinding>
                                    </controls:Chip.Text>
                                </controls:Chip>
                                <controls:Chip Text="{Binding BreakTimeInSeconds, StringFormat={x:Static constants:UiText.RestChipFormat}}" />
                                <controls:Chip Text="{Binding TargetRPE, StringFormat={x:Static constants:UiText.TargetRpeFormat}}" IsAccent="True" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.FooterTemplate>
                <DataTemplate x:DataType="viewmodels:AddEditWorkoutViewModel">
                    <Border Style="{StaticResource DashedOutline}" Margin="0,12,0,16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddExerciseCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static constants:UiText.ButtonAddExerciseInline}"
                               TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
                               HorizontalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.FooterTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Padding="{markup:Gutter Top=12, Bottom=16}" Spacing="8">
            <controls:TappableButton Style="{StaticResource PrimaryButton}"
                                     Text="{x:Static constants:UiText.ButtonSaveWorkout}"
                                     Command="{Binding SaveWorkoutCommand}" />
            <Label Style="{StaticResource CaptionLabel}"
                   Text="{x:Static constants:UiText.HintSaveWorkout}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding CanSave, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>

        <controls:BottomSheet Grid.RowSpan="4" IsOpen="{Binding IsExercisePickerOpen}">
            <controls:ExercisePickerSheet Picker="{Binding ExercisePicker}"
                                          PickCommand="{Binding PickExerciseCommand}"
                                          CloseCommand="{Binding CloseExercisePickerCommand}"
                                          CreateCommand="{Binding CreateExerciseCommand}" />
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="4" IsOpen="{Binding IsConfigurationOpen}">
            <VerticalStackLayout Spacing="16">
                <controls:SheetItemHeader Title="{Binding ExerciseConfiguration.ExerciseName}" />

                <VerticalStackLayout Spacing="10">
                    <controls:ValueStepper Title="{x:Static constants:UiText.LabelSets}"
                                           Value="{Binding ExerciseConfiguration.Sets}"
                                           Minimum="{x:Static constants:DomainDefaults.MinSets}"
                                           Maximum="{x:Static constants:DomainDefaults.MaxSets}" />
                    <controls:ValueStepper Title="{x:Static constants:UiText.LabelReps}"
                                           Value="{Binding ExerciseConfiguration.Reps}"
                                           Minimum="{x:Static constants:DomainDefaults.MinReps}"
                                           Maximum="{x:Static constants:DomainDefaults.MaxReps}" />

                    <Border Style="{StaticResource InsetPanel}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{x:Static constants:UiText.LabelRest}" />
                                <Label Grid.Column="1"
                                       Text="{Binding ExerciseConfiguration.BreakTimeInSeconds, StringFormat={x:Static constants:UiText.RestDurationFormat}}"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            </Grid>
                            <FlexLayout RadioButtonGroup.GroupName="RestPresets"
                                        RadioButtonGroup.SelectedValue="{Binding ExerciseConfiguration.SelectedRestPreset}"
                                        BindableLayout.ItemsSource="{Binding ExerciseConfiguration.RestPresets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:RestPreset">
                                        <RadioButton Style="{StaticResource SegmentChip}"
                                                     FlexLayout.Grow="1"
                                                     FlexLayout.Basis="0"
                                                     Margin="2,0"
                                                     Content="{Binding Label}"
                                                     Value="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <controls:ValueStepper Title="{x:Static constants:UiText.LabelCustom}"
                                                   IsVisible="{Binding ExerciseConfiguration.IsCustomRest}"
                                                   Value="{Binding ExerciseConfiguration.BreakTimeInSeconds}"
                                                   Minimum="{x:Static constants:DomainDefaults.MinBreakTimeInSeconds}"
                                                   Maximum="{x:Static constants:DomainDefaults.MaxBreakTimeInSeconds}"
                                                   Step="{x:Static constants:DomainDefaults.BreakTimeStepInSeconds}"
                                                   ValueFormat="{x:Static constants:UiText.RestDurationFormat}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource InsetPanel}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{x:Static constants:UiText.LabelTargetRpe}" />
                                <Label Grid.Column="1"
                                       Text="{Binding ExerciseConfiguration.TargetRPE}"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            </Grid>
                            <FlexLayout BindableLayout.ItemsSource="{Binding ExerciseConfiguration.RpeLevels}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LevelSegment">
                                        <Grid FlexLayout.Grow="1"
                                              FlexLayout.Basis="0"
                                              Padding="2.5,0"
                                              HeightRequest="28"
                                              BackgroundColor="Transparent">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddEditWorkoutViewModel}}, Path=ExerciseConfiguration.SelectRpeCommand}"
                                                                      CommandParameter="{Binding Value}" />
                                            </Grid.GestureRecognizers>
                                            <BoxView HeightRequest="8"
                                                     CornerRadius="{StaticResource LevelBarRadius}"
                                                     VerticalOptions="Center"
                                                     Color="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsFilled}" Value="True">
                                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Style="{StaticResource CaptionLabel}" Text="{x:Static constants:UiText.LabelRpeEasy}" />
                                <Label Grid.Column="1" Style="{StaticResource CaptionLabel}" Text="{x:Static constants:UiText.LabelRpeMax}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <controls:TappableButton Style="{StaticResource SmallTextButton}"
                                         Text="{x:Static constants:UiText.ButtonRemoveFromWorkout}"
                                         HorizontalOptions="Center"
                                         IsVisible="{Binding ExerciseConfiguration.IsEditing}"
                                         Command="{Binding RemoveEditedExerciseCommand}" />
            </VerticalStackLayout>
            <controls:BottomSheet.Footer>
                <controls:SheetActionBar ConfirmText="{Binding ExerciseConfiguration.ConfirmText}"
                                         CancelCommand="{Binding CancelConfigurationCommand}"
                                         ConfirmCommand="{Binding ConfirmConfigurationCommand}" />
            </controls:BottomSheet.Footer>
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="4" IsOpen="{Binding IsExerciseFormOpen}">
            <controls:ExerciseFormSheet Form="{Binding ExerciseForm}" />
            <controls:BottomSheet.Footer>
                <controls:SheetActionBar ConfirmText="{Binding ExerciseForm.ConfirmText}"
                                         CancelCommand="{Binding CancelExerciseFormCommand}"
                                         ConfirmCommand="{Binding SaveNewExerciseCommand}" />
            </controls:BottomSheet.Footer>
        </controls:BottomSheet>
    </Grid>

</controls:BackNavigationPage>
