<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             x:Class="MuscleMemory.Views.AddEditWorkoutPage"
             x:DataType="viewmodels:AddEditWorkoutViewModel"
             Title="Create Workout"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <Border Grid.Row="0" Stroke="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}" StrokeThickness="1" Padding="15,5" Margin="0,0,0,20">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Entry Text="{Binding WorkoutName}"
                   Placeholder="Workout name"
                   PlaceholderColor="{StaticResource TranslucentBlack}"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}"
                   FontSize="20"
                   FontAttributes="Bold"
                   ClearButtonVisibility="WhileEditing"/>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Exercises}">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                    <Label Text="You have no exercises in&#10;that workout, let's add&#10;more!"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#99000000, Dark=#B3FFFFFF}"
                           FontFamily="LilitaOne"
                           FontSize="18" />
                    <Button Text="Add exercise +" 
                            Clicked="OnAddExerciseClicked"
                            BackgroundColor="Transparent" 
                            TextColor="{StaticResource PrimaryRed}"
                            FontFamily="LilitaOne"
                            FontSize="18"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Header>
                <Button Text="Add exercise +" 
                        Clicked="OnAddExerciseClicked"
                        BackgroundColor="Transparent" 
                        TextColor="{StaticResource PrimaryRed}"
                        FontFamily="LilitaOne"
                        FontSize="18"
                        HorizontalOptions="End"
                        Margin="0,0,0,15"/>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkoutExercise">
                    <Border Margin="0,0,0,10" Padding="15" Stroke="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditExerciseTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding ExerciseName}" TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" FontSize="18" FontFamily="LilitaOne"/>
                                <Label Text="{Binding Sets, StringFormat='Sets: {0}'}" TextColor="{AppThemeBinding Light=#99000000, Dark=#B3FFFFFF}" FontSize="14" />
                                <Label Text="{Binding Reps, StringFormat='Reps: {0}'}" TextColor="{AppThemeBinding Light=#99000000, Dark=#B3FFFFFF}" FontSize="14" />
                                <Label Text="{Binding BreakTimeInSeconds, StringFormat='Break: {0} sec'}" TextColor="{AppThemeBinding Light=#99000000, Dark=#B3FFFFFF}" FontSize="14" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                <Button Text="Edit" 
                                        Clicked="OnEditButtonClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" 
                                        TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" 
                                        BorderColor="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}"
                                        BorderWidth="1"
                                        FontAttributes="Bold" 
                                        FontFamily="LilitaOne"
                                        CornerRadius="20"
                                        HeightRequest="36"
                                        Padding="10,0"/>
                                <Button Text="Delete" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddEditWorkoutViewModel}}, Path=RemoveExerciseCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" 
                                        TextColor="{StaticResource PrimaryRed}" 
                                        BorderColor="{StaticResource PrimaryRed}"
                                        BorderWidth="1"
                                        FontAttributes="Bold" 
                                        FontFamily="LilitaOne"
                                        CornerRadius="20"
                                        HeightRequest="36"
                                        Padding="10,0"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Save"
                Command="{Binding SaveWorkoutCommand}"
                BackgroundColor="{StaticResource PrimaryRed}"
                TextColor="{StaticResource SolidWhite}"
                FontFamily="LilitaOne"
                FontSize="18"
                CornerRadius="25"
                HeightRequest="50"
                Margin="0,20,0,0">
            <Button.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Button.Shadow>
        </Button>
    </Grid>

</ContentPage>
