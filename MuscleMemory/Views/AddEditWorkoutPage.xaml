<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Name="PageRoot"
             x:Class="MuscleMemory.Views.AddEditWorkoutPage"
             x:DataType="viewmodels:AddEditWorkoutViewModel"
             Title="Create Workout"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding BindingContext.StartGuardingUnsavedChangesCommand, Source={x:Reference PageRoot}}" />
        <toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding BindingContext.StopGuardingUnsavedChangesCommand, Source={x:Reference PageRoot}}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <Border Grid.Row="0" Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" Padding="15,5" Margin="0,0,0,20">
            <Border.Shadow>
                <Shadow Brush="{StaticResource ShadowColor}" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Entry Text="{Binding WorkoutName}"
                   Placeholder="Workout name"
                   PlaceholderColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                   FontSize="20"
                   FontAttributes="Bold"
                   ClearButtonVisibility="WhileEditing"/>
        </Border>

        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding Exercises}">
                <CollectionView.Header>
                    <Button Text="Add exercise +" 
                            Command="{Binding AddExerciseCommand}"
                            BackgroundColor="Transparent" 
                            TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                            FontFamily="LilitaOne"
                            FontSize="18"
                            HorizontalOptions="End"
                            Margin="0,0,0,15"/>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkoutExercise">
                        <Border Margin="0,0,0,10" Padding="15" Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource ShadowColor}" Offset="0,4" Opacity="0.15" Radius="10"/>
                            </Border.Shadow>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddEditWorkoutViewModel}}, Path=EditExerciseCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding ExerciseName}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontSize="18" FontFamily="LilitaOne"/>
                                    <Label Text="{Binding Sets, StringFormat='Sets: {0}'}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" FontSize="14" />
                                    <Label Text="{Binding Reps, StringFormat='Reps: {0}'}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" FontSize="14" />
                                    <Label Text="{Binding BreakTimeInSeconds, StringFormat='Break: {0} sec'}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" FontSize="14" />
                                    <Label Text="{Binding TargetRPE, StringFormat='Target RPE: {0}'}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" FontSize="14" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <Button Text="Edit" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddEditWorkoutViewModel}}, Path=EditExerciseCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" 
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                            BorderColor="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}"
                                            BorderWidth="1"
                                            FontAttributes="Bold" 
                                            FontFamily="LilitaOne"
                                            CornerRadius="20"
                                            HeightRequest="36"
                                            Padding="10,0"/>
                                    <Button Text="Delete" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddEditWorkoutViewModel}}, Path=RemoveExerciseCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" 
                                            TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" 
                                            BorderColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                            BorderWidth="1"
                                            FontAttributes="Bold" 
                                            FontFamily="LilitaOne"
                                            CornerRadius="20"
                                            HeightRequest="36"
                                            Padding="10,0"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20" IsVisible="{Binding IsEmpty}">
                <Label Text="You have no exercises in&#10;that workout, let's add&#10;more!"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                       FontFamily="LilitaOne"
                       FontSize="18" />
                <Button Text="Add exercise +" 
                        Command="{Binding AddExerciseCommand}"
                        BackgroundColor="Transparent" 
                        TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                        FontFamily="LilitaOne"
                        FontSize="18"/>
            </VerticalStackLayout>
        </Grid>

        <Button Grid.Row="2"
                Text="Save"
                Command="{Binding SaveWorkoutCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                TextColor="{StaticResource OnAccentText}"
                FontFamily="LilitaOne"
                FontSize="18"
                CornerRadius="25"
                HeightRequest="50"
                Margin="0,20,0,0">
            <Button.Shadow>
                <Shadow Brush="{StaticResource ShadowColor}" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Button.Shadow>
        </Button>
    </Grid>

</ContentPage>
