<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Views.WorkoutHistoryPage"
             x:DataType="viewmodels:WorkoutHistoryViewModel"
             Title="{Binding WorkoutName}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid>
        <controls:EmptyState Message="No history available for this workout yet.&#10;Complete a session to see your progress!"
                             IsVisible="{Binding IsEmpty}" />
        
        <CollectionView ItemsSource="{Binding Sessions}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkoutHistorySession">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,15">
                        <VerticalStackLayout Spacing="10">
                                                        <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding StartTime, StringFormat='{0:MMM dd, yyyy}'}" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" FontSize="18" />
                                <Label Grid.Column="1" Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" FontSize="16" />
                            </Grid>
                            <Label Text="{Binding TotalVolume, StringFormat='Total Volume: {0} kg'}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontSize="16" />
                            
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutHistoryExercise">
                                        <SwipeView Margin="0,10,0,0">
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Reveal">
                                                    <SwipeItemView Command="{Binding BindingContext.DeleteExerciseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}">
                                                        <controls:SwipeAction Style="{StaticResource DeleteSwipeAction}" />
                                                    </SwipeItemView>
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            
                                            <VerticalStackLayout Spacing="5">
                                                <Label Text="{Binding ExerciseName}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontSize="16" />
                                                <Border Stroke="{AppThemeBinding Light={StaticResource SubtleStrokeLight}, Dark={StaticResource SubtleStrokeDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SubtleSurfaceBackgroundLight}, Dark={StaticResource SubtleSurfaceBackgroundDark}}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout>
                                                        <controls:SetTableHeader />
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="models:WorkoutSet">
                                                                    <SwipeView>
                                                                        <SwipeView.RightItems>
                                                                            <SwipeItems Mode="Reveal">
                                                                                <SwipeItemView Command="{Binding BindingContext.DeleteSetCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}">
                                                                                    <controls:SwipeAction Style="{StaticResource DeleteSwipeAction}" />
                                                                                </SwipeItemView>
                                                                            </SwipeItems>
                                                                        </SwipeView.RightItems>
                                                                        <Border BackgroundColor="Transparent" StrokeThickness="0">
                                                                            <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding BindingContext.EditSetCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                                                            </Border.GestureRecognizers>
                                                                            <Grid ColumnDefinitions="*,*,*" Padding="8">
                                                                                <Label Grid.Column="0" Text="{Binding SetNumber}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontSize="14" HorizontalTextAlignment="Center" />
                                                                                <Label Grid.Column="1" Text="{Binding Weight}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontSize="14" HorizontalTextAlignment="Center" />
                                                                                <Label Grid.Column="2" Text="{Binding Reps}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontSize="14" HorizontalTextAlignment="Center" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </SwipeView>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                        
                                                        <controls:TappableButton Text="+ Add Set"
                                                                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                                                                 FontSize="12"
                                                                                 HeightRequest="30"
                                                                                 ContentPadding="10,0"
                                                                                 Margin="0,5,0,5"
                                                                                 HorizontalOptions="Center"
                                                                                 Command="{Binding BindingContext.AddSetCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                                                 CommandParameter="{Binding .}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </VerticalStackLayout>
                                        </SwipeView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            
                            <controls:TappableButton Style="{StaticResource PrimaryButton}"
                                                     Text="Add Exercise"
                                                     FontSize="16"
                                                     HeightRequest="50"
                                                     Margin="0,15,0,0"
                                                     Command="{Binding BindingContext.AddExerciseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                     CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

