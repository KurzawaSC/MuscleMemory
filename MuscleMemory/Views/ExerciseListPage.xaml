<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
                             xmlns:models="clr-namespace:MuscleMemory.Models"
                             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                             xmlns:controls="clr-namespace:MuscleMemory.Controls"
                             xmlns:constants="clr-namespace:MuscleMemory.Constants"
                             x:Name="PageRoot"
                             x:Class="MuscleMemory.Views.ExerciseListPage"
                             x:DataType="viewmodels:ExerciseListViewModel"
                             BackCommand="{Binding CloseSheetsCommand}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding BindingContext.LoadExercisesCommand, Source={x:Reference PageRoot}}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <controls:ScreenHeader Title="Exercises" Subtitle="Build your movement library" />

        <Border Grid.Row="1"
                Style="{StaticResource FormField}"
                Margin="20,8,20,0"
                IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
            <Entry Text="{Binding SearchText}"
                   Placeholder="Search exercises"
                   ClearButtonVisibility="WhileEditing" />
        </Border>

        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,12,0,0"
                    IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
            <HorizontalStackLayout Padding="20,0"
                                   Spacing="8"
                                   RadioButtonGroup.GroupName="ExerciseListFilters"
                                   RadioButtonGroup.SelectedValue="{Binding SelectedFilter}"
                                   BindableLayout.ItemsSource="{Binding Filters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MuscleGroupFilter">
                        <RadioButton Style="{StaticResource FilterChip}"
                                     Content="{Binding Label}"
                                     Value="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Label Grid.Row="3"
               Text="No exercises match your search"
               TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
               HorizontalOptions="Center"
               Margin="20,24,20,0"
               IsVisible="{Binding HasNoMatches}" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Exercises}" Margin="20,12,20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource CardSpacing}" />
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <Border Style="{StaticResource SurfaceCard}" Stroke="Transparent" StrokeThickness="2" Padding="14">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource AreEqualConverter}">
                                        <Binding Path="." />
                                        <Binding Path="ActionExercise" Source="{RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout x:Name="CardContent" Spacing="8" BackgroundColor="Transparent">
                                <VerticalStackLayout.Behaviors>
                                    <toolkit:TouchBehavior LongPressDuration="{x:Static constants:UiTiming.LongPressMilliseconds}"
                                                           LongPressCommand="{Binding BindingContext.LongPressExerciseCommand, Source={x:Reference PageRoot}}"
                                                           LongPressCommandParameter="{Binding BindingContext, Source={x:Reference CardContent}}" />
                                </VerticalStackLayout.Behaviors>
                                <Label Style="{StaticResource TitleLabel}" Text="{Binding Name}" />
                                <HorizontalStackLayout Spacing="6">
                                    <controls:Chip Text="{Binding TargetMuscleGroup, Converter={StaticResource EnumDisplayNameConverter}}" />
                                    <controls:Chip Text="{Binding Equipment, Converter={StaticResource EnumDisplayNameConverter}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Grid Grid.Column="1"
                                  WidthRequest="{StaticResource TouchTarget}"
                                  HeightRequest="{StaticResource TouchTarget}"
                                  VerticalOptions="Start"
                                  Margin="0,-9,-9,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=ShowExerciseActionsCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Border WidthRequest="30"
                                        HeightRequest="30"
                                        StrokeThickness="0"
                                        InputTransparent="True"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                        <BoxView Style="{StaticResource OverflowDot}" />
                                        <BoxView Style="{StaticResource OverflowDot}" />
                                        <BoxView Style="{StaticResource OverflowDot}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:EmptyState Grid.Row="1"
                             Grid.RowSpan="3"
                             Message="No exercises yet"
                             Detail="Add your first exercise, then build a workout from it."
                             ActionText="Add exercise"
                             ActionCommand="{Binding AddExerciseCommand}"
                             ShowsAction="{Binding ActiveWorkout.CanAddItems}"
                             IsVisible="{Binding IsEmpty}" />

        <controls:FloatingActionButton Grid.Row="3" Command="{Binding AddExerciseCommand}">
            <controls:FloatingActionButton.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="ActiveWorkout.CanAddItems" />
                    <Binding Path="IsEmpty" Converter="{StaticResource InvertedBoolConverter}" />
                </MultiBinding>
            </controls:FloatingActionButton.IsVisible>
        </controls:FloatingActionButton>
        <controls:ResumeWorkoutBanner Grid.Row="3" ActiveWorkout="{Binding ActiveWorkout}" />

        <controls:BottomSheet Grid.RowSpan="4" IsOpen="{Binding IsActionSheetOpen}">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="Auto, *"
                      ColumnSpacing="12"
                      BindingContext="{Binding ActionExercise}"
                      x:DataType="models:Exercise">
                    <Border WidthRequest="44"
                            HeightRequest="44"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource SmallControlRadius}" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Name, Converter={StaticResource InitialsConverter}, FallbackValue=''}"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Style="{StaticResource TitleLabel}"
                               Text="{Binding Name, FallbackValue=''}"
                               LineBreakMode="TailTruncation" />
                        <Label Style="{StaticResource CaptionLabel}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0} · {1}" FallbackValue="">
                                    <Binding Path="TargetMuscleGroup" Converter="{StaticResource EnumDisplayNameConverter}" />
                                    <Binding Path="Equipment" Converter="{StaticResource EnumDisplayNameConverter}" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout>
                    <controls:ActionSheetRow Text="Edit exercise"
                                             TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                             Command="{Binding EditActionExerciseCommand}" />
                    <BoxView Style="{StaticResource Divider}" />
                    <controls:ActionSheetRow Text="View history"
                                             TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                             Command="{Binding ViewActionExerciseHistoryCommand}" />
                    <BoxView Style="{StaticResource Divider}" />
                    <controls:ActionSheetRow Text="Delete exercise"
                                             TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                             ShowsChevron="False"
                                             Command="{Binding DeleteActionExerciseCommand}" />
                </VerticalStackLayout>

                <controls:TappableButton Style="{StaticResource SecondaryButton}"
                                         Text="Cancel"
                                         Command="{Binding CancelExerciseActionsCommand}" />
            </VerticalStackLayout>
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="4" IsOpen="{Binding IsExerciseFormOpen}">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource TitleLabel}" Text="{Binding ExerciseForm.Title}" />
                    <Label Style="{StaticResource CaptionLabel}" Text="Name is required, everything else is optional" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource OverlineLabel}" Text="Name" />
                    <Border Style="{StaticResource FormField}" HeightRequest="52">
                        <Entry Text="{Binding ExerciseForm.Name}"
                               Placeholder="e.g. Incline Bench Press"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource OverlineLabel}" Text="Muscle group" />
                    <FlexLayout Wrap="Wrap"
                                AlignContent="Start"
                                AlignItems="Start"
                                RadioButtonGroup.GroupName="ExerciseFormMuscleGroup"
                                RadioButtonGroup.SelectedValue="{Binding ExerciseForm.SelectedMuscleGroup}"
                                BindableLayout.ItemsSource="{Binding ExerciseForm.MuscleGroups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MuscleGroup">
                                <RadioButton Style="{StaticResource ChoiceChip}"
                                             Margin="0,0,4,4"
                                             Content="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}"
                                             Value="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource OverlineLabel}" Text="Equipment" />
                    <FlexLayout Wrap="Wrap"
                                AlignContent="Start"
                                AlignItems="Start"
                                RadioButtonGroup.GroupName="ExerciseFormEquipment"
                                RadioButtonGroup.SelectedValue="{Binding ExerciseForm.SelectedEquipment}"
                                BindableLayout.ItemsSource="{Binding ExerciseForm.EquipmentTypes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:EquipmentType">
                                <RadioButton Style="{StaticResource ChoiceChip}"
                                             Margin="0,0,4,4"
                                             Content="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}"
                                             Value="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <controls:PopupActionBar ConfirmText="{Binding ExerciseForm.ConfirmText}"
                                         IsConfirmEnabled="{Binding ExerciseForm.CanSave}"
                                         CancelCommand="{Binding CancelExerciseFormCommand}"
                                         ConfirmCommand="{Binding SaveExerciseCommand}" />
            </VerticalStackLayout>
        </controls:BottomSheet>
    </Grid>

</controls:BackNavigationPage>
