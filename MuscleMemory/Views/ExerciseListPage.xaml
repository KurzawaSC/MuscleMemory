<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MuscleMemory.Views.ExerciseListPage"
             x:DataType="viewmodels:ExerciseListViewModel"
             Title="Exercise List"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadExercisesCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Spacing="20"
                             IsVisible="{Binding IsEmpty}">
            <Image Source="empty_exercise_list_icon.png" WidthRequest="80" HeightRequest="80" Opacity="0.3" />
            <Label Text="Your exercise list is empty.&#10;Tap + to add your first!" 
                   TextColor="{AppThemeBinding Light=#99000000, Dark=#B3FFFFFF}" 
                   FontSize="18" 
                   FontFamily="LilitaOne"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Exercises}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=DeleteExerciseCommand}" CommandParameter="{Binding .}">
                                    <Border BackgroundColor="Transparent" Margin="4,6,4,6" Padding="20,8" Stroke="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}" StrokeThickness="1.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Delete" TextColor="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}" FontFamily="LilitaOne" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=EditExerciseCommand}" CommandParameter="{Binding .}">
                                    <Border BackgroundColor="Transparent" Margin="4,6,4,6" Padding="20,8" Stroke="{StaticResource SolidBlack}" StrokeThickness="1.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Edit" TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" FontFamily="LilitaOne" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <Border Padding="15" Stroke="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E22}">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
                            </Border.Shadow>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="5">
                                    <Label Text="{Binding Name}" 
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" 
                                           FontSize="18" 
                                           FontFamily="LilitaOne" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Border Padding="8,4" BackgroundColor="Transparent" Stroke="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding TargetMuscleGroup}" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" FontSize="12" FontFamily="LilitaOne" />
                                        </Border>
                                        <Border Padding="8,4" BackgroundColor="Transparent" Stroke="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Equipment}" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" FontSize="12" FontFamily="LilitaOne" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <Button Text="History" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=ViewHistoryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" 
                                            TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" 
                                            BorderColor="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}"
                                            BorderWidth="1"
                                            FontAttributes="Bold" 
                                            FontFamily="LilitaOne"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            Padding="15,0"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Margin="20"
              HeightRequest="60" 
              WidthRequest="60"
              HorizontalOptions="End" 
              VerticalOptions="End"
              IsVisible="{Binding CanAddItems}">

            <Border BackgroundColor="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}" StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>
            </Border>

            <Image Source="plus_icon.png"
                   WidthRequest="24"
                   HeightRequest="24"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   InputTransparent="True">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource SolidWhite}" />
                </Image.Behaviors>
            </Image>

            <Button BackgroundColor="Transparent" 
                    Command="{Binding AddExerciseCommand}" 
                    CornerRadius="30" />
        </Grid>
        <Border Margin="15,0,15,20"
                HorizontalOptions="Fill" 
                VerticalOptions="End"
                Padding="16"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}"
                IsVisible="{Binding Source={x:Static viewmodels:ActiveWorkoutViewModel.Current}, Path=IsBannerVisible}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={x:Static viewmodels:ActiveWorkoutViewModel.Current}, Path=ResumeWorkoutCommand}" />
            </Border.GestureRecognizers>
            <Label Text="Workout in Progress - Tap to Resume" HorizontalTextAlignment="Center" TextColor="White" FontFamily="LilitaOne" VerticalOptions="Center" FontSize="16" />
        </Border>
    </Grid>

</ContentPage>
