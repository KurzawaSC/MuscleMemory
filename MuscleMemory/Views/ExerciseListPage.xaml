<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
                             xmlns:models="clr-namespace:MuscleMemory.Models"
                             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                             xmlns:controls="clr-namespace:MuscleMemory.Controls"
                             xmlns:constants="clr-namespace:MuscleMemory.Constants"
                             xmlns:platform="clr-namespace:MuscleMemory"
                             xmlns:markup="clr-namespace:MuscleMemory.Markup"
                             x:Name="PageRoot"
                             x:Class="MuscleMemory.Views.ExerciseListPage"
                             x:DataType="viewmodels:ExerciseListViewModel"
                             BackCommand="{Binding CloseSheetsCommand}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding BindingContext.LoadExercisesCommand, Source={x:Reference PageRoot}}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <controls:ScreenHeader Title="{x:Static constants:UiText.HeaderExercises}" Subtitle="{x:Static constants:UiText.SubtitleExercises}" />

        <controls:TextField Grid.Row="1"
                            Margin="{markup:Gutter Top=8}"
                            Text="{Binding Filter.SearchText}"
                            Placeholder="{x:Static constants:UiText.PlaceholderSearchExercises}"
                            ClearButtonVisibility="WhileEditing"
                            IsVisible="{Binding ListState.HasItems}" />

        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,12,0,0"
                    IsVisible="{Binding ListState.HasItems}">
            <HorizontalStackLayout Padding="{markup:Gutter}"
                                   Spacing="8"
                                   RadioButtonGroup.GroupName="ExerciseListFilters"
                                   RadioButtonGroup.SelectedValue="{Binding Filter.SelectedFilter}"
                                   BindableLayout.ItemsSource="{Binding Filter.Filters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MuscleGroupFilter">
                        <RadioButton Style="{StaticResource FilterChip}"
                                     Content="{Binding Label}"
                                     Value="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="3"
                             Margin="{markup:Gutter Top=24}"
                             IsVisible="{Binding HasNoMatches}">
            <Label Text="{x:Static constants:UiText.EmptyNoMatchingExercises}"
                   TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Exercises}" Margin="{markup:Gutter Top=12}">
            <CollectionView.Behaviors>
                <controls:ScrollToTopOnInsertBehavior />
            </CollectionView.Behaviors>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource CardSpacing}" />
            </CollectionView.ItemsLayout>
            <CollectionView.FooterTemplate>
                <DataTemplate x:DataType="x:Object">
                    <BoxView HeightRequest="{StaticResource ListFooterSpacing}" Color="Transparent" />
                </DataTemplate>
            </CollectionView.FooterTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <Border Style="{StaticResource SelectableCard}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource AreEqualConverter}">
                                        <Binding Path="." />
                                        <Binding Path="ActionExercise" Source="{RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout x:Name="CardContent" Spacing="8" BackgroundColor="Transparent">
                                <VerticalStackLayout.Behaviors>
                                    <platform:LongPressBehavior Command="{Binding BindingContext.LongPressExerciseCommand, Source={x:Reference PageRoot}}"
                                                                CommandParameter="{Binding BindingContext, Source={x:Reference CardContent}}" />
                                </VerticalStackLayout.Behaviors>
                                <Label Style="{StaticResource TitleLabel}" Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="6">
                                    <controls:Chip Text="{Binding TargetMuscleGroup, Converter={StaticResource EnumDisplayNameConverter}}" />
                                    <controls:Chip Text="{Binding Equipment, Converter={StaticResource EnumDisplayNameConverter}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <controls:OverflowButton Grid.Column="1"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=ShowExerciseActionsCommand}"
                                                     CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:EmptyState Grid.Row="1"
                             Grid.RowSpan="3"
                             Message="{x:Static constants:UiText.EmptyExercisesMessage}"
                             Detail="{x:Static constants:UiText.EmptyExercisesDetail}"
                             ActionText="{x:Static constants:UiText.ButtonAddExercise}"
                             ActionCommand="{Binding AddExerciseCommand}"
                             ShowsAction="{Binding ActiveWorkout.CanAddItems}"
                             IsVisible="{Binding ListState.IsEmpty}" />

        <controls:FloatingActionButton Grid.Row="3" Command="{Binding AddExerciseCommand}">
            <controls:FloatingActionButton.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="ActiveWorkout.CanAddItems" />
                    <Binding Path="ListState.HasItems" />
                </MultiBinding>
            </controls:FloatingActionButton.IsVisible>
        </controls:FloatingActionButton>
        <controls:ResumeWorkoutBanner Grid.Row="3" ActiveWorkout="{Binding ActiveWorkout}" />

        <controls:BottomSheet Grid.RowSpan="4" IsOpen="{Binding IsActionSheetOpen}">
            <controls:ItemActionsSheet Title="{Binding ActionExercise.Name, FallbackValue=''}"
                                       Subtitle="{Binding ActionExerciseSubtitle}"
                                       EditText="{x:Static constants:UiText.HeaderEditExercise}"
                                       DeleteText="{x:Static constants:UiText.TitleDeleteExercise}"
                                       EditCommand="{Binding EditActionExerciseCommand}"
                                       HistoryCommand="{Binding ViewActionExerciseHistoryCommand}"
                                       DeleteCommand="{Binding DeleteActionExerciseCommand}"
                                       CancelCommand="{Binding CancelExerciseActionsCommand}" />
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="4" IsOpen="{Binding IsExerciseFormOpen}">
            <controls:ExerciseFormSheet Form="{Binding ExerciseForm}" />
            <controls:BottomSheet.Footer>
                <controls:SheetActionBar ConfirmText="{Binding ExerciseForm.ConfirmText}"
                                         CancelCommand="{Binding CancelExerciseFormCommand}"
                                         ConfirmCommand="{Binding SaveExerciseCommand}" />
            </controls:BottomSheet.Footer>
        </controls:BottomSheet>
    </Grid>

</controls:BackNavigationPage>
