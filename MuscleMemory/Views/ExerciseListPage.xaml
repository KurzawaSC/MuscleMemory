<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MuscleMemory.Views.ExerciseListPage"
             x:DataType="viewmodels:ExerciseListViewModel"
             Title="Exercise List"
             BackgroundColor="{StaticResource SolidWhite}">

    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Spacing="20"
                             IsVisible="{Binding IsEmpty}">
            <Image Source="empty_exercise_list_icon.png" WidthRequest="80" HeightRequest="80" Opacity="0.3" />
            <Label Text="Your exercise list is empty.&#10;Tap + to add your first!" 
                   TextColor="{StaticResource TranslucentBlack}" 
                   FontSize="18" 
                   FontFamily="LilitaOne"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Exercises}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=DeleteExerciseCommand}" CommandParameter="{Binding .}">
                                    <Border BackgroundColor="Transparent" Margin="4,6,4,6" Padding="20,8" Stroke="{StaticResource PrimaryRed}" StrokeThickness="1.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Delete" TextColor="{StaticResource PrimaryRed}" FontFamily="LilitaOne" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=EditExerciseCommand}" CommandParameter="{Binding .}">
                                    <Border BackgroundColor="Transparent" Margin="4,6,4,6" Padding="20,8" Stroke="{StaticResource SolidBlack}" StrokeThickness="1.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Edit" TextColor="{StaticResource SolidBlack}" FontFamily="LilitaOne" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <Border Padding="15" Stroke="{StaticResource TranslucentBlack}" StrokeThickness="1" BackgroundColor="{StaticResource SolidWhite}">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
                            </Border.Shadow>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       TextColor="{StaticResource SolidBlack}" 
                                       FontSize="18" 
                                       FontFamily="LilitaOne"
                                       VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <Button Text="History" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ExerciseListViewModel}}, Path=ViewHistoryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" 
                                            TextColor="{StaticResource SolidBlack}" 
                                            BorderColor="{StaticResource TranslucentBlack}"
                                            BorderWidth="1"
                                            FontAttributes="Bold" 
                                            FontFamily="LilitaOne"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            Padding="15,0"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Margin="20"
              HeightRequest="60" 
              WidthRequest="60"
              HorizontalOptions="End" 
              VerticalOptions="End">

            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>
            </Border>

            <Image Source="plus_icon.png"
                   WidthRequest="24"
                   HeightRequest="24"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   InputTransparent="True">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource SolidWhite}" />
                </Image.Behaviors>
            </Image>

            <Button BackgroundColor="Transparent" 
                    Clicked="OnAddButtonClicked" 
                    CornerRadius="30" />
        </Grid>
    </Grid>

</ContentPage>