<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
                             xmlns:services="clr-namespace:MuscleMemory.Services"
                             xmlns:controls="clr-namespace:MuscleMemory.Controls"
                             xmlns:markup="clr-namespace:MuscleMemory.Markup"
                             xmlns:loc="clr-namespace:MuscleMemory.Localization"
                             x:Class="MuscleMemory.Views.SettingsPage"
                             x:DataType="viewmodels:SettingsViewModel"
                             BackCommand="{Binding CloseSheetsCommand}">

    <Grid RowDefinitions="Auto, *">
        <controls:ScreenHeader Title="{loc:Text HeaderSettings}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{markup:Gutter Top=12, Bottom=20}" Spacing="8">
                <Label Style="{StaticResource OverlineLabel}" Text="{loc:Text LabelAppearance}" />
                <Border Style="{StaticResource SettingsGroup}">
                    <controls:ActionRow Text="{loc:Text LabelAppTheme}"
                                        Value="{Binding ThemeText}"
                                        TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                        Command="{Binding OpenThemeSheetCommand}" />
                </Border>

                <Label Style="{StaticResource OverlineLabel}" Text="{loc:Text LabelLanguage}" Margin="0,10,0,0" />
                <Border Style="{StaticResource SettingsGroup}">
                    <controls:ActionRow Text="{loc:Text LabelLanguage}"
                                        Value="{Binding LanguageText}"
                                        TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                        Command="{Binding OpenLanguageSheetCommand}" />
                </Border>

                <Label Style="{StaticResource OverlineLabel}" Text="{loc:Text LabelData}" Margin="0,10,0,0" />
                <Border Style="{StaticResource SettingsGroup}">
                    <VerticalStackLayout>
                        <controls:ActionRow Text="{loc:Text ActionExportData}"
                                            TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                            Command="{Binding ExportDataCommand}" />
                        <BoxView Style="{StaticResource Divider}" />
                        <controls:ActionRow Text="{loc:Text ActionImportData}"
                                            TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                            Command="{Binding ImportDataCommand}" />
                        <BoxView Style="{StaticResource Divider}" />
                        <controls:ActionRow Text="{loc:Text ActionEraseAllData}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                            Command="{Binding OpenEraseSheetCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource CaptionLabel}"
                       Text="{Binding VersionText}"
                       TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:ResumeWorkoutBanner Grid.Row="1" ActiveWorkout="{Binding ActiveWorkout}" />

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding IsThemeSheetOpen}">
            <VerticalStackLayout Spacing="16">
                <Label Style="{StaticResource TitleLabel}" Text="{loc:Text LabelAppTheme}" />
                <Grid ColumnDefinitions="*, *, *"
                      ColumnSpacing="10"
                      RadioButtonGroup.GroupName="AppTheme"
                      RadioButtonGroup.SelectedValue="{Binding SelectedTheme}">
                    <RadioButton Style="{StaticResource ThemeCard}"
                                 Value="{x:Static services:ThemePreference.System}"
                                 SemanticProperties.Description="{loc:Text ThemeOptionSystem}">
                        <RadioButton.Content>
                            <VerticalStackLayout Spacing="9">
                                <Border Style="{StaticResource ThemePreview}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource SurfaceLight}" Offset="0.5" />
                                            <GradientStop Color="{StaticResource SurfaceDark}" Offset="0.5" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Label Style="{StaticResource SmallLabel}" Text="{loc:Text ThemeNameSystem}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton Grid.Column="1"
                                 Style="{StaticResource ThemeCard}"
                                 Value="{x:Static services:ThemePreference.Light}"
                                 SemanticProperties.Description="{loc:Text ThemeOptionLight}">
                        <RadioButton.Content>
                            <VerticalStackLayout Spacing="9">
                                <Border Style="{StaticResource ThemePreview}" BackgroundColor="{StaticResource SurfaceLight}" />
                                <Label Style="{StaticResource SmallLabel}" Text="{loc:Text ThemeNameLight}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton Grid.Column="2"
                                 Style="{StaticResource ThemeCard}"
                                 Value="{x:Static services:ThemePreference.Dark}"
                                 SemanticProperties.Description="{loc:Text ThemeOptionDark}">
                        <RadioButton.Content>
                            <VerticalStackLayout Spacing="9">
                                <Border Style="{StaticResource ThemePreview}" BackgroundColor="{StaticResource SurfaceDark}" />
                                <Label Style="{StaticResource SmallLabel}" Text="{loc:Text ThemeNameDark}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </RadioButton.Content>
                    </RadioButton>
                </Grid>
            </VerticalStackLayout>
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding IsLanguageSheetOpen}">
            <VerticalStackLayout Spacing="16">
                <Label Style="{StaticResource TitleLabel}" Text="{loc:Text LabelLanguage}" />
                <VerticalStackLayout Spacing="10"
                                     RadioButtonGroup.GroupName="AppLanguage"
                                     RadioButtonGroup.SelectedValue="{Binding SelectedLanguage}"
                                     BindableLayout.ItemsSource="{Binding Languages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LanguageOption">
                            <RadioButton Style="{StaticResource ThemeCard}"
                                         Value="{Binding .}"
                                         SemanticProperties.Description="{Binding Label}">
                                <RadioButton.Content>
                                    <Label Text="{Binding Label, Source={RelativeSource AncestorType={x:Type viewmodels:LanguageOption}}}" />
                                </RadioButton.Content>
                            </RadioButton>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding IsEraseSheetOpen}">
            <Border StrokeThickness="0"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CardRadius}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource MediumTitleLabel}" Text="{loc:Text TitleEraseAllData}" />
                    <Label Style="{StaticResource LargeCaptionLabel}"
                           Text="{loc:Text BodyEraseAllData}" />
                </VerticalStackLayout>
            </Border>
            <controls:BottomSheet.Footer>
                <controls:SheetActionBar ConfirmText="{loc:Text ButtonErase}"
                                         CancelCommand="{Binding CloseEraseSheetCommand}"
                                         ConfirmCommand="{Binding EraseDataCommand}" />
            </controls:BottomSheet.Footer>
        </controls:BottomSheet>
    </Grid>

</controls:BackNavigationPage>
