<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             x:Class="MuscleMemory.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{StaticResource SolidWhite}">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Button Text="Export data"
                Command="{Binding ExportDataCommand}"
                ImageSource="export_data_icon.png"
                ContentLayout="Left, 15"
                BackgroundColor="{StaticResource SolidWhite}"
                TextColor="{StaticResource SolidBlack}"
                BorderColor="{StaticResource TranslucentBlack}"
                BorderWidth="1"
                FontFamily="LilitaOne"
                FontSize="18"
                CornerRadius="16"
                HeightRequest="60"
                HorizontalOptions="Fill">
            <Button.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Button.Shadow>
        </Button>

        <Button Text="Erease data"
                Command="{Binding EraseDataCommand}"
                ImageSource="erease_data_icon.png"
                ContentLayout="Left, 15"
                BackgroundColor="{StaticResource SolidWhite}"
                TextColor="{StaticResource PrimaryRed}"
                BorderColor="{StaticResource TranslucentBlack}"
                BorderWidth="1"
                FontFamily="LilitaOne"
                FontSize="18"
                CornerRadius="16"
                HeightRequest="60"
                HorizontalOptions="Fill">
            <Button.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Button.Shadow>
        </Button>

    </VerticalStackLayout>
</ContentPage>