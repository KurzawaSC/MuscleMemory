<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             x:Class="MuscleMemory.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Border Padding="15,0" HeightRequest="60" Stroke="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E22}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <Label Grid.Column="0" Text="App Theme" FontFamily="LilitaOne" FontSize="18" TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" VerticalOptions="Center" HorizontalOptions="Start" />
                <Picker Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" FontFamily="LilitaOne" FontSize="16" MinimumWidthRequest="130" VerticalOptions="Center" HorizontalOptions="End" />
            </Grid>
        </Border>

        <Button Text="Export data"
                Command="{Binding ExportDataCommand}"
                ImageSource="export_data_icon.png"
                ContentLayout="Left, 15"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E22}"
                TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}"
                BorderColor="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}"
                BorderWidth="1"
                FontFamily="LilitaOne"
                FontSize="18"
                CornerRadius="16"
                HeightRequest="60"
                HorizontalOptions="Fill">
            <Button.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Button.Shadow>
        </Button>

        <Button Text="Erease data"
                Command="{Binding EraseDataCommand}"
                ImageSource="erease_data_icon.png"
                ContentLayout="Left, 15"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E22}"
                TextColor="{StaticResource PrimaryRed}"
                BorderColor="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}"
                BorderWidth="1"
                FontFamily="LilitaOne"
                FontSize="18"
                CornerRadius="16"
                HeightRequest="60"
                HorizontalOptions="Fill">
            <Button.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Button.Shadow>
        </Button>

    </VerticalStackLayout>
</ContentPage>
