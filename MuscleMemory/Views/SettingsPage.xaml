<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
                             xmlns:services="clr-namespace:MuscleMemory.Services"
                             xmlns:controls="clr-namespace:MuscleMemory.Controls"
                             xmlns:constants="clr-namespace:MuscleMemory.Constants"
                             xmlns:markup="clr-namespace:MuscleMemory.Markup"
                             x:Class="MuscleMemory.Views.SettingsPage"
                             x:DataType="viewmodels:SettingsViewModel"
                             BackCommand="{Binding CloseSheetsCommand}">

    <Grid RowDefinitions="Auto, *">
        <controls:ScreenHeader Title="{x:Static constants:UiText.HeaderSettings}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{markup:Gutter Top=12, Bottom=20}" Spacing="8">
                <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.LabelAppearance}" />
                <Border Style="{StaticResource SettingsGroup}">
                    <controls:ActionRow Text="{x:Static constants:UiText.LabelAppTheme}"
                                        Value="{Binding SelectedTheme, Converter={StaticResource EnumDisplayNameConverter}}"
                                        TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                        Command="{Binding OpenThemeSheetCommand}" />
                </Border>

                <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.LabelData}" Margin="0,10,0,0" />
                <Border Style="{StaticResource SettingsGroup}">
                    <VerticalStackLayout>
                        <controls:ActionRow Text="{x:Static constants:UiText.ActionExportData}"
                                            TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                            Command="{Binding ExportDataCommand}" />
                        <BoxView Style="{StaticResource Divider}" />
                        <controls:ActionRow Text="{x:Static constants:UiText.ActionImportData}"
                                            TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                            Command="{Binding ImportDataCommand}" />
                        <BoxView Style="{StaticResource Divider}" />
                        <controls:ActionRow Text="{x:Static constants:UiText.ActionEraseAllData}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                            Command="{Binding OpenEraseSheetCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource CaptionLabel}"
                       Text="{Binding VersionText}"
                       TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:ResumeWorkoutBanner Grid.Row="1" ActiveWorkout="{Binding ActiveWorkout}" />

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding IsThemeSheetOpen}">
            <VerticalStackLayout Spacing="16">
                <Label Style="{StaticResource TitleLabel}" Text="{x:Static constants:UiText.LabelAppTheme}" />
                <Grid ColumnDefinitions="*, *, *"
                      ColumnSpacing="10"
                      RadioButtonGroup.GroupName="AppTheme"
                      RadioButtonGroup.SelectedValue="{Binding SelectedTheme}">
                    <RadioButton Style="{StaticResource ThemeCard}"
                                 Value="{x:Static services:ThemePreference.System}"
                                 SemanticProperties.Description="{x:Static constants:UiText.ThemeOptionSystem}">
                        <RadioButton.Content>
                            <VerticalStackLayout Spacing="9">
                                <Border Style="{StaticResource ThemePreview}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource SurfaceLight}" Offset="0.5" />
                                            <GradientStop Color="{StaticResource SurfaceDark}" Offset="0.5" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Label Style="{StaticResource SmallLabel}" Text="{x:Static constants:UiText.ThemeNameSystem}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton Grid.Column="1"
                                 Style="{StaticResource ThemeCard}"
                                 Value="{x:Static services:ThemePreference.Light}"
                                 SemanticProperties.Description="{x:Static constants:UiText.ThemeOptionLight}">
                        <RadioButton.Content>
                            <VerticalStackLayout Spacing="9">
                                <Border Style="{StaticResource ThemePreview}" BackgroundColor="{StaticResource SurfaceLight}" />
                                <Label Style="{StaticResource SmallLabel}" Text="{x:Static constants:UiText.ThemeNameLight}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </RadioButton.Content>
                    </RadioButton>
                    <RadioButton Grid.Column="2"
                                 Style="{StaticResource ThemeCard}"
                                 Value="{x:Static services:ThemePreference.Dark}"
                                 SemanticProperties.Description="{x:Static constants:UiText.ThemeOptionDark}">
                        <RadioButton.Content>
                            <VerticalStackLayout Spacing="9">
                                <Border Style="{StaticResource ThemePreview}" BackgroundColor="{StaticResource SurfaceDark}" />
                                <Label Style="{StaticResource SmallLabel}" Text="{x:Static constants:UiText.ThemeNameDark}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </RadioButton.Content>
                    </RadioButton>
                </Grid>
            </VerticalStackLayout>
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding IsEraseSheetOpen}">
            <Border StrokeThickness="0"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CardRadius}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource MediumTitleLabel}" Text="{x:Static constants:UiText.TitleEraseAllData}" />
                    <Label Style="{StaticResource LargeCaptionLabel}"
                           Text="{x:Static constants:UiText.BodyEraseAllData}" />
                </VerticalStackLayout>
            </Border>
            <controls:BottomSheet.Footer>
                <controls:SheetActionBar ConfirmText="{x:Static constants:UiText.ButtonErase}"
                                         CancelCommand="{Binding CloseEraseSheetCommand}"
                                         ConfirmCommand="{Binding EraseDataCommand}" />
            </controls:BottomSheet.Footer>
        </controls:BottomSheet>
    </Grid>

</controls:BackNavigationPage>
