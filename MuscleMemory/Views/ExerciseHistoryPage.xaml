<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
                             xmlns:models="clr-namespace:MuscleMemory.Models"
                             xmlns:controls="clr-namespace:MuscleMemory.Controls"
                             xmlns:constants="clr-namespace:MuscleMemory.Constants"
                             xmlns:markup="clr-namespace:MuscleMemory.Markup"
                             x:Class="MuscleMemory.Views.ExerciseHistoryPage"
                             x:DataType="viewmodels:ExerciseHistoryViewModel"
                             BackCommand="{Binding GoBackCommand}">

    <Grid RowDefinitions="Auto, Auto, *">
        <controls:NavigationHeader Title="{x:Static constants:UiText.HeaderExerciseHistory}" BackCommand="{Binding GoBackCommand}" />

        <controls:ScreenHeader Grid.Row="1"
                               Title="{Binding ExerciseName}"
                               Subtitle="{Binding SessionCountText}" />

        <controls:EmptyState Grid.Row="2"
                             Message="{x:Static constants:UiText.EmptyExerciseHistory}"
                             IsVisible="{Binding ListState.IsEmpty}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding History}" Margin="{markup:Gutter Top=8}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource CardSpacing}" />
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ExerciseHistoryItem">
                    <Border Style="{StaticResource SurfaceCard}" Padding="16,14,16,10">
                        <Border.Resources>
                            <Style TargetType="VerticalStackLayout">
                                <Setter Property="SafeAreaEdges" Value="None" />
                            </Style>
                            <Style TargetType="Grid">
                                <Setter Property="SafeAreaEdges" Value="None" />
                            </Style>
                        </Border.Resources>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Label Style="{StaticResource CardTitleLabel}"
                                       Text="{Binding Entry.WorkoutName}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Style="{StaticResource CaptionLabel}"
                                       Text="{Binding DateText}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entry.Sets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutSet">
                                        <VerticalStackLayout>
                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Padding="0,9">
                                                <Border WidthRequest="22"
                                                        HeightRequest="22"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource ChipRadius}" />
                                                    </Border.StrokeShape>
                                                    <Label Style="{StaticResource SmallCaptionLabel}"
                                                           Text="{Binding SetNumber}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <Label Grid.Column="1" VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Weight}" />
                                                            <Span Style="{StaticResource UnitSpan}" Text="{x:Static constants:UiText.KilogramSuffix}" />
                                                            <Span Text="{x:Static constants:UiText.WeightRepsSeparator}"
                                                                  TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}" />
                                                            <Span Text="{Binding Reps}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Grid>
                                            <BoxView Style="{StaticResource Divider}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*, Auto" Padding="0,3,0,0">
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding SetCountText}" />
                                <controls:UnitLabel Grid.Column="1"
                                                    Style="{StaticResource CaptionLabel}"
                                                    Value="{Binding VolumeText}"
                                                    Unit="{x:Static constants:UiText.VolumeSuffix}"
                                                    ValueColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</controls:BackNavigationPage>
