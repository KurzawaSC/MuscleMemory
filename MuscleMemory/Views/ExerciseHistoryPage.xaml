<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             x:Class="MuscleMemory.Views.ExerciseHistoryPage"
             x:DataType="viewmodels:ExerciseHistoryViewModel"
             Title="{Binding ExerciseName}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Spacing="20"
                             IsVisible="{Binding IsEmpty}">
            <Label Text="No history available for this exercise yet.&#10;Complete it in a workout to see your progress!" 
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" 
                   FontSize="18" 
                   FontFamily="LilitaOne"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        
        <CollectionView ItemsSource="{Binding History}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExerciseHistoryEntry">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,15">
                        <VerticalStackLayout Spacing="10">
                                                        <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding WorkoutName}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontSize="18" FontFamily="LilitaOne" />
                                <Label Grid.Column="1" Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" FontSize="16" />
                            </Grid>
                            
                                                        <Border Stroke="{AppThemeBinding Light={StaticResource SubtleStrokeLight}, Dark={StaticResource SubtleStrokeDark}}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={StaticResource SubtleSurfaceBackgroundLight}, Dark={StaticResource SubtleSurfaceBackgroundDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,*,*" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource TableHeaderBackgroundLight}, Dark={StaticResource TableHeaderBackgroundDark}}">
                                        <Label Grid.Column="0" Text="Set" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontFamily="LilitaOne" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="Weight (kg)" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontFamily="LilitaOne" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="2" Text="Reps" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" FontFamily="LilitaOne" HorizontalTextAlignment="Center" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:WorkoutSet">
                                                <Grid ColumnDefinitions="*,*,*" Padding="10" BackgroundColor="Transparent">
                                                    <Label Grid.Column="0" Text="{Binding SetNumber}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" HorizontalTextAlignment="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Weight}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" HorizontalTextAlignment="Center" />
                                                    <Label Grid.Column="2" Text="{Binding Reps}" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" HorizontalTextAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

