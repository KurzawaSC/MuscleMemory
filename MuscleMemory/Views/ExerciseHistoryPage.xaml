<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
                             xmlns:controls="clr-namespace:MuscleMemory.Controls"
                             xmlns:markup="clr-namespace:MuscleMemory.Markup"
                             xmlns:loc="clr-namespace:MuscleMemory.Localization"
                             x:Class="MuscleMemory.Views.ExerciseHistoryPage"
                             x:DataType="viewmodels:ExerciseHistoryViewModel"
                             BackCommand="{Binding GoBackCommand}">

    <Grid RowDefinitions="Auto, Auto, *">
        <controls:NavigationHeader Title="{loc:Text HeaderExerciseHistory}" BackCommand="{Binding GoBackCommand}" />

        <controls:ScreenHeader Grid.Row="1"
                               Title="{Binding ExerciseName}"
                               Subtitle="{Binding SessionCountText}" />

        <controls:EmptyState Grid.Row="2"
                             Message="{loc:Text EmptyExerciseHistory}"
                             IsVisible="{Binding ListState.IsEmpty}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding History}" Header="{Binding .}" Margin="{markup:Gutter Top=8}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource CardSpacing}" />
            </CollectionView.ItemsLayout>
            <CollectionView.HeaderTemplate>
                <DataTemplate x:DataType="viewmodels:ExerciseHistoryViewModel">
                    <VerticalStackLayout Spacing="8" Padding="0,0,0,4" IsVisible="{Binding HasHeader}">
                        <Label Style="{StaticResource OverlineLabel}" Text="{loc:Text LabelRecords}" />
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" BindableLayout.ItemsSource="{Binding Records.Records}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PersonalRecordItem">
                                    <controls:StatTile Grid.Row="{Binding Row}"
                                                       Grid.Column="{Binding Column}"
                                                       Margin="0,0,0,10"
                                                       Padding="14"
                                                       ContentSpacing="2"
                                                       Value="{Binding ValueText}"
                                                       Caption="{Binding Caption}"
                                                       Description="{Binding Description}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <Label Style="{StaticResource OverlineLabel}" Text="{loc:Text LabelProgress}" />
                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Border Style="{StaticResource InsetPanel}" Padding="4">
                                    <FlexLayout RadioButtonGroup.GroupName="ProgressMetrics"
                                                RadioButtonGroup.SelectedValue="{Binding Progress.SelectedMetric}"
                                                BindableLayout.ItemsSource="{Binding Progress.Metrics}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:EnumOption">
                                                <RadioButton Style="{StaticResource SegmentChip}"
                                                             FlexLayout.Grow="1"
                                                             FlexLayout.Basis="0"
                                                             Margin="2,0"
                                                             Content="{Binding Label}"
                                                             Value="{Binding Value}"
                                                             SemanticProperties.Description="{Binding Description}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </Border>

                                <Border Style="{StaticResource InsetPanel}" Padding="4">
                                    <FlexLayout RadioButtonGroup.GroupName="ProgressRanges"
                                                RadioButtonGroup.SelectedValue="{Binding Progress.SelectedRange}"
                                                BindableLayout.ItemsSource="{Binding Progress.Ranges}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:EnumOption">
                                                <RadioButton Style="{StaticResource SegmentChip}"
                                                             FlexLayout.Grow="1"
                                                             FlexLayout.Basis="0"
                                                             Margin="2,0"
                                                             Content="{Binding Label}"
                                                             Value="{Binding Value}"
                                                             SemanticProperties.Description="{Binding Description}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </Border>

                                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8">
                                    <Label Style="{StaticResource CompactLabel}" Text="{Binding Progress.SelectionText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Progress.HasChart}" Value="False">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Grid Grid.Row="1" HeightRequest="{StaticResource ProgressChartHeight}">
                                        <controls:ProgressChart Model="{Binding Progress.Chart}"
                                                                SelectedIndex="{Binding Progress.SelectedIndex}"
                                                                SelectCommand="{Binding Progress.SelectPointCommand}"
                                                                IsVisible="{Binding Progress.HasChart}"
                                                                SemanticProperties.Description="{Binding Progress.Description}"
                                                                LineColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                                                SurfaceColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                                                GridColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                                                LabelColor="{AppThemeBinding Light={StaticResource InkBodyLight}, Dark={StaticResource InkBodyDark}}"
                                                                TrendColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
                                                                GuideColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}" />
                                    </Grid>

                                    <Label Grid.Row="2"
                                           Style="{StaticResource SmallLabel}"
                                           Text="{Binding Progress.TrendText}"
                                           TextColor="{AppThemeBinding Light={StaticResource InkBodyLight}, Dark={StaticResource InkBodyDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Progress.HasChart}" Value="False">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Grid.RowSpan="3"
                                           Style="{StaticResource SmallLabel}"
                                           Text="{loc:Text ChartTooFewSessions}"
                                           TextColor="{AppThemeBinding Light={StaticResource InkBodyLight}, Dark={StaticResource InkBodyDark}}"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding Progress.IsTooShort}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Label Style="{StaticResource OverlineLabel}" Text="{loc:Text LabelSessions}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.HeaderTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ExerciseHistoryItem">
                    <Border Style="{StaticResource SurfaceCard}" Padding="16,14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Label Style="{StaticResource CardTitleLabel}"
                                       Text="{Binding Entry.WorkoutName}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Style="{StaticResource CaptionLabel}"
                                       Text="{Binding DateText}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border Style="{StaticResource SetTable}">
                                <VerticalStackLayout>
                                    <controls:SetTableHeader />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:LoggedSetItem">
                                                <controls:SetTableRow Set="{Binding .}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding SetCountText}" />
                                <controls:UnitLabel Grid.Column="1"
                                                    Style="{StaticResource CaptionLabel}"
                                                    Value="{Binding VolumeText}"
                                                    Unit="{loc:Text VolumeSuffix}"
                                                    ValueColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</controls:BackNavigationPage>
