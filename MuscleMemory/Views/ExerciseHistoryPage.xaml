<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:services="clr-namespace:MuscleMemory.Services"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Views.ExerciseHistoryPage"
             x:DataType="viewmodels:ExerciseHistoryViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto, *">
        <controls:NavigationHeader Title="{Binding ExerciseName, StringFormat='{0} · history'}" BackCommand="{Binding GoBackCommand}" />

        <controls:EmptyState Grid.Row="1"
                             Message="No history available for this exercise yet.&#10;Complete it in a workout to see your progress!"
                             IsVisible="{Binding IsEmpty}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding History}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:ExerciseHistoryEntry">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,15">
                        <VerticalStackLayout Spacing="10">
                                                        <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding WorkoutName}" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" FontSize="18" />
                                <Label Grid.Column="1" Text="{Binding LocalDate, StringFormat='{0:MMM dd, yyyy}'}" TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" FontSize="16" />
                            </Grid>
                            
                            <Border Style="{StaticResource SetTable}">
                                <VerticalStackLayout>
                                    <controls:SetTableHeader />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:WorkoutSet">
                                                <controls:SetTableRow Set="{Binding .}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

