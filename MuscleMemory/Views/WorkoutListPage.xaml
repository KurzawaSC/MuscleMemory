<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Name="PageRoot"
             x:Class="MuscleMemory.Views.WorkoutListPage"
             x:DataType="viewmodels:WorkoutListViewModel"
             Title="Start Workout"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding BindingContext.LoadWorkoutsCommand, Source={x:Reference PageRoot}}" />
    </ContentPage.Behaviors>

    <Grid>
        <controls:EmptyState IconSource="empty_workout_list_icon.png"
                             Message="No workouts added yet.&#10;Tap + to create one!"
                             IsVisible="{Binding IsEmpty}" />
        <CollectionView ItemsSource="{Binding Workouts}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Workout">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=DeleteWorkoutCommand}" CommandParameter="{Binding .}">
                                    <controls:SwipeAction Style="{StaticResource DeleteSwipeAction}" />
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=EditWorkoutCommand}" CommandParameter="{Binding .}">
                                    <controls:SwipeAction Style="{StaticResource EditSwipeAction}" />
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <Border Style="{StaticResource SurfaceCard}">

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                       FontSize="20" 
                                       VerticalOptions="Center"/>

                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <controls:TappableButton Style="{StaticResource OutlineButton}"
                                                             Text="History"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=ViewHistoryCommand}"
                                                             CommandParameter="{Binding .}" />
                                    <controls:TappableButton Style="{StaticResource PrimaryButton}"
                                                             Text="Start"
                                                             FontSize="14"
                                                             FontAttributes="Bold"
                                                             HeightRequest="40"
                                                             ContentPadding="15,0"
                                                             SurfaceShadow="{x:Null}"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=StartWorkoutCommand}"
                                                             CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:FloatingActionButton Command="{Binding NavigateToAddWorkoutCommand}" IsVisible="{Binding ActiveWorkout.CanAddItems}" />
        <controls:ResumeWorkoutBanner ActiveWorkout="{Binding ActiveWorkout}" />
    </Grid>

</ContentPage>
