<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             x:Class="MuscleMemory.Views.WorkoutListPage"
             x:DataType="viewmodels:WorkoutListViewModel"
             Title="Start Workout"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadWorkoutsCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Spacing="20"
                             IsVisible="{Binding IsEmpty}">
            <Image Source="empty_workout_list_icon.png" WidthRequest="80" HeightRequest="80" Opacity="0.3" />
            <Label Text="No workouts added yet.&#10;Tap + to create one!" 
                   TextColor="{AppThemeBinding Light=#99000000, Dark=#B3FFFFFF}" 
                   FontSize="18" 
                   FontFamily="LilitaOne"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Workouts}" Margin="20">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Workout">
                    <SwipeView Margin="0,0,0,10">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=DeleteWorkoutCommand}" CommandParameter="{Binding .}">
                                    <Border BackgroundColor="Transparent" Margin="4,6,4,6" Padding="20,8" Stroke="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}" StrokeThickness="1.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Delete" TextColor="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}" FontFamily="LilitaOne" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=EditWorkoutCommand}" CommandParameter="{Binding .}">
                                    <Border BackgroundColor="Transparent" Margin="4,6,4,6" Padding="20,8" Stroke="{StaticResource SolidBlack}" StrokeThickness="1.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Edit" TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" FontFamily="LilitaOne" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <Border Padding="15" Stroke="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E22}">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
                            </Border.Shadow>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding Name}" 
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" 
                                       FontSize="20" 
                                       FontFamily="LilitaOne"
                                       VerticalOptions="Center"/>

                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <Button Text="History" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=ViewHistoryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" 
                                            TextColor="{AppThemeBinding Light=#000000, Dark=#F5F5F7}" 
                                            BorderColor="{AppThemeBinding Light=#99000000, Dark=#66FFFFFF}"
                                            BorderWidth="1"
                                            FontAttributes="Bold" 
                                            FontFamily="LilitaOne"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            Padding="15,0"/>
                                    <Button Text="Start" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:WorkoutListViewModel}}, Path=StartWorkoutCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}" 
                                            TextColor="{StaticResource SolidWhite}" 
                                            BorderWidth="0"
                                            FontAttributes="Bold" 
                                            FontFamily="LilitaOne"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            Padding="15,0"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Margin="20" 
                HeightRequest="60" 
                WidthRequest="60"
                BackgroundColor="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}"
                StrokeThickness="0"
                HorizontalOptions="End" 
                VerticalOptions="End"
                IsVisible="{Binding ActiveWorkout.CanAddItems}">

            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Border.Shadow>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavigateToAddWorkoutCommand}" />
            </Border.GestureRecognizers>

            <Image Source="plus_icon.png"
                   WidthRequest="24"
                   HeightRequest="24"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   InputTransparent="True">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource SolidWhite}" />
                </Image.Behaviors>
            </Image>
        </Border>
        <Border Margin="15,0,15,20"
                HorizontalOptions="Fill" 
                VerticalOptions="End"
                Padding="16"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#FF4040, Dark=#D32F2F}"
                IsVisible="{Binding ActiveWorkout.IsBannerVisible}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Opacity="0.15" Radius="10"/>
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ActiveWorkout.ResumeWorkoutCommand}" />
            </Border.GestureRecognizers>
            <Label Text="Workout in Progress - Tap to Resume" HorizontalTextAlignment="Center" TextColor="White" FontFamily="LilitaOne" VerticalOptions="Center" FontSize="16" />
        </Border>
    </Grid>

</ContentPage>
