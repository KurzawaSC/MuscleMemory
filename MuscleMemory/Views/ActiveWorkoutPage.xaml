<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:constants="clr-namespace:MuscleMemory.Constants"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:markup="clr-namespace:MuscleMemory.Markup"
             x:Class="MuscleMemory.Views.ActiveWorkoutPage"
             x:DataType="viewmodels:ActiveWorkoutViewModel"
             BackCommand="{Binding NavigateBackCommand}">

    <controls:BackNavigationPage.Resources>
        <toolkit:BoolToObjectConverter x:Key="SaveSetButtonStyleConverter"
                                       TrueObject="{StaticResource SecondaryButton}"
                                       FalseObject="{StaticResource PrimaryButton}" />
        <toolkit:BoolToObjectConverter x:Key="FinishButtonStyleConverter"
                                       TrueObject="{StaticResource PrimaryButton}"
                                       FalseObject="{StaticResource DangerOutlineButton}" />
    </controls:BackNavigationPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <Grid ColumnDefinitions="Auto, *, Auto" Padding="{markup:Gutter Top=10}" IsVisible="{Binding Summary.IsVisible, Converter={StaticResource InvertedBoolConverter}}">
            <controls:GlyphButton Glyph="‹"
                                  Style="{StaticResource NavigationGlyphButton}"
                                  Command="{Binding NavigateBackCommand}" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Style="{StaticResource LargeCaptionLabel}"
                       Text="{Binding WorkoutTitle}"
                       LineBreakMode="TailTruncation"
                       HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource CompactTimerLabel}"
                       Text="{Binding TimerText}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <controls:TappableButton Grid.Column="2"
                                     Style="{StaticResource CompactSoftButton}"
                                     Text="{x:Static constants:UiText.ButtonFinish}"
                                     Command="{Binding FinishWorkoutCommand}" />
        </Grid>

        <Grid Grid.Row="1"
              RowDefinitions="Auto, Auto, *, Auto"
              RowSpacing="14"
              Padding="{markup:Gutter Top=16, Bottom=12}"
              IsVisible="{Binding Summary.IsVisible, Converter={StaticResource InvertedBoolConverter}}">

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsExercisesEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <FlexLayout BindableLayout.ItemsSource="{Binding SetSegments}"
                            IsVisible="{Binding Rest.IsResting, Converter={StaticResource InvertedBoolConverter}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LevelSegment">
                            <BoxView FlexLayout.Grow="1"
                                     FlexLayout.Basis="0"
                                     Margin="3,0"
                                     HeightRequest="4"
                                     CornerRadius="{StaticResource IndicatorRadius}"
                                     Color="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsFilled}" Value="True">
                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Style="{StaticResource TitleLabel}"
                               Text="{Binding CurrentExercise.ExerciseName, FallbackValue=''}"
                               LineBreakMode="TailTruncation" />
                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding ProgressCaption}" />
                    </VerticalStackLayout>
                    <controls:GlyphButton Grid.Column="1"
                                          Glyph="‹"
                                          Style="{StaticResource NavigationGlyphButton}"
                                          SurfaceSize="34"
                                          Command="{Binding PreviousExerciseCommand}"
                                          IsVisible="{Binding HasPreviousExercise}" />
                    <controls:GlyphButton Grid.Column="2"
                                          Glyph="›"
                                          Style="{StaticResource NavigationGlyphButton}"
                                          SurfaceSize="34"
                                          Command="{Binding NextExerciseCommand}"
                                          IsVisible="{Binding HasNextExercise}" />
                </Grid>
            </VerticalStackLayout>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource SurfaceCard}" Padding="0">
                    <Border.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                            <Binding Path="Rest.IsResting" Converter="{StaticResource InvertedBoolConverter}" />
                            <Binding Path="IsExercisesEmpty" Converter="{StaticResource InvertedBoolConverter}" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <VerticalStackLayout Spacing="14" Padding="16">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Style="{StaticResource OverlineLabel}" Text="{Binding TargetText}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource CaptionLabel}"
                                   Text="{Binding LastSessionResultsText}"
                                   LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="End">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasLastSession}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                        <controls:InputStepper Title="{x:Static constants:UiText.LabelWeightInKg}"
                                               Text="{Binding SetInput.WeightInput}"
                                               MaxLength="{x:Static constants:InputLimits.MaxWeightInputLength}"
                                               ErrorText="{Binding SetInput.WeightError}"
                                               DecrementCommand="{Binding SetInput.DecreaseWeightCommand}"
                                               IncrementCommand="{Binding SetInput.IncreaseWeightCommand}" />
                        <controls:InputStepper Title="{x:Static constants:UiText.LabelReps}"
                                               Text="{Binding SetInput.RepsInput}"
                                               MaxLength="{x:Static constants:InputLimits.MaxRepsInputLength}"
                                               ErrorText="{Binding SetInput.RepsError}"
                                               DecrementCommand="{Binding SetInput.DecreaseRepsCommand}"
                                               IncrementCommand="{Binding SetInput.IncreaseRepsCommand}" />

                        <Grid ColumnDefinitions="Auto, *">
                            <controls:TappableButton Style="{StaticResource SecondaryButton}"
                                                     Text="{x:Static constants:UiText.ButtonUndo}"
                                                     WidthRequest="120"
                                                     Margin="0,0,10,0"
                                                     Command="{Binding UndoLastSetCommand}"
                                                     IsVisible="{Binding HasSavedSets}" />
                            <controls:TappableButton Grid.Column="1"
                                                     Style="{Binding IsPlanComplete, Converter={StaticResource SaveSetButtonStyleConverter}}"
                                                     Text="{x:Static constants:UiText.ButtonSaveSet}"
                                                     PressedScale="0.97"
                                                     Command="{Binding SaveSetCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource RestPanel}" IsVisible="{Binding Rest.IsResting}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource OverlineLabel}"
                               Text="{x:Static constants:UiText.LabelRest}"
                               TextColor="{AppThemeBinding Light={StaticResource OnRestPanelMutedLight}, Dark={StaticResource OnRestPanelMutedDark}}"
                               HorizontalTextAlignment="Center" />
                        <controls:PulseView PulseKey="{Binding Rest.TimerText}" IsPulsing="{Binding Rest.IsEnding}" Margin="0,14,0,6" HorizontalOptions="Center">
                            <Grid WidthRequest="150" HeightRequest="150">
                                <controls:RestRing Progress="{Binding Rest.Progress}"
                                                   Thickness="13"
                                                   ProgressColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}"
                                                   TrackColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Style="{StaticResource CompactTimerLabel}"
                                           Text="{Binding Rest.TimerText}"
                                           TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Style="{StaticResource CaptionLabel}"
                                           Text="{Binding Rest.TotalText}"
                                           TextColor="{AppThemeBinding Light={StaticResource OnRestPanelMutedLight}, Dark={StaticResource OnRestPanelMutedDark}}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </controls:PulseView>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,14,0,0">
                            <controls:TappableButton Style="{StaticResource RestPanelSubtleButton}"
                                                     Text="{Binding Rest.ExtensionText}"
                                                     Command="{Binding Rest.ExtendCommand}" />
                            <controls:TappableButton Grid.Column="1"
                                                     Style="{StaticResource RestPanelButton}"
                                                     Text="{x:Static constants:UiText.ButtonSkipRest}"
                                                     Command="{Binding Rest.SkipCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never" IsVisible="{Binding HasSavedSets}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.LabelThisSession}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Rest.IsResting}" Value="True">
                                <Setter Property="Text" Value="{x:Static constants:UiText.LabelLoggedSets}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border Style="{StaticResource CompactCard}" Padding="14,2">
                        <VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentSets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutSet">
                                        <controls:FadeInView>
                                            <VerticalStackLayout BackgroundColor="Transparent">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActiveWorkoutViewModel}}, Path=SetActions.ShowCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </VerticalStackLayout.GestureRecognizers>
                                                <Grid ColumnDefinitions="*, Auto" Padding="0,12">
                                                    <Label Style="{StaticResource LargeCaptionLabel}"
                                                           Text="{Binding SetNumber, StringFormat={x:Static constants:UiText.SetProgressFormat}}" />
                                                    <Label Grid.Column="1" Style="{StaticResource CompactLabel}">
                                                        <Label.Text>
                                                            <MultiBinding StringFormat="{x:Static constants:UiText.LoggedSetFormat}">
                                                                <Binding Path="Weight" />
                                                                <Binding Path="Reps" />
                                                            </MultiBinding>
                                                        </Label.Text>
                                                    </Label>
                                                </Grid>
                                                <BoxView Style="{StaticResource Divider}" />
                                            </VerticalStackLayout>
                                        </controls:FadeInView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*, Auto" Padding="0,12">
                                <Label Style="{StaticResource LargeCaptionLabel}" Text="{x:Static constants:UiText.LabelVolume}" />
                                <Label Grid.Column="1" Style="{StaticResource CompactLabel}" Text="{Binding CurrentVolumeText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2"
                                 Spacing="10"
                                 Padding="{markup:Gutter}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <VerticalStackLayout.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                        <Binding Path="HasSavedSets" Converter="{StaticResource InvertedBoolConverter}" />
                        <Binding Path="Rest.IsResting" Converter="{StaticResource InvertedBoolConverter}" />
                    </MultiBinding>
                </VerticalStackLayout.IsVisible>
                <Border Style="{StaticResource SurfaceCard}"
                        WidthRequest="64"
                        HeightRequest="64"
                        Padding="0"
                        Shadow="{x:Null}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CardRadius}" />
                    </Border.StrokeShape>
                    <Label Style="{StaticResource TitleLabel}"
                           Text="1"
                           TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Style="{StaticResource LargeCaptionLabel}"
                       Text="{x:Static constants:UiText.HintFirstTimeExercise}"
                       HorizontalTextAlignment="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasLastSession}" Value="True">
                            <Setter Property="Text" Value="{x:Static constants:UiText.HintPrefilledFromLastSession}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <controls:TappableButton Grid.Row="3"
                                     Style="{Binding IsPlanComplete, Converter={StaticResource FinishButtonStyleConverter}}"
                                     Text="{x:Static constants:UiText.TitleFinishWorkout}"
                                     HeightRequest="{StaticResource LargeButtonHeight}"
                                     Command="{Binding FinishWorkoutCommand}" />
        </Grid>

        <Grid Grid.RowSpan="2" RowDefinitions="*, Auto" IsVisible="{Binding Summary.IsVisible}">
            <ScrollView>
                <VerticalStackLayout Padding="{markup:Gutter Top=16}" Spacing="4">
                    <Label Style="{StaticResource OverlineLabel}"
                           Text="{x:Static constants:UiText.LabelWorkoutComplete}"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Style="{StaticResource DisplayLabel}" Text="{Binding WorkoutTitle}" />
                    <Label Style="{StaticResource LargeCaptionLabel}" Text="{Binding Summary.DateText}" />

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10" Margin="0,12,0,0">
                        <Border Style="{StaticResource SurfaceCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource ValueLabel}" Text="{Binding Summary.TotalTimeText}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{x:Static constants:UiText.CaptionTime}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label LineBreakMode="NoWrap">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource ValueSpan}"
                                                  Text="{Binding Summary.TotalVolume, StringFormat={x:Static constants:UiText.VolumeNumberFormat}}"
                                                  TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                            <Span Style="{StaticResource UnitSpan}" Text="{x:Static constants:UiText.KilogramSuffix}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Style="{StaticResource CaptionLabel}" Text="{x:Static constants:UiText.CaptionVolume}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource ValueLabel}" Text="{Binding Summary.TotalSets}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding Summary.TotalSetsCaption}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.HeaderExercises}" Margin="0,18,0,6" />

                    <VerticalStackLayout Spacing="10" Margin="0,0,0,14" BindableLayout.ItemsSource="{Binding Summary.Exercises}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SummaryExerciseItem">
                                <Border Style="{StaticResource SurfaceCard}" Padding="16,14">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <Label Style="{StaticResource CardTitleLabel}"
                                                   Text="{Binding ExerciseName}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1"
                                                   Style="{StaticResource MiniLabel}"
                                                   Text="{Binding VolumeText}"
                                                   TextColor="{AppThemeBinding Light={StaticResource InkBodyLight}, Dark={StaticResource InkBodyDark}}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Sets}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:SummarySetBar">
                                                    <Grid ColumnDefinitions="14, *" ColumnSpacing="10">
                                                        <Label Style="{StaticResource SmallCaptionLabel}"
                                                               Text="{Binding SetNumber}"
                                                               TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}"
                                                               VerticalOptions="Center" />
                                                        <AbsoluteLayout Grid.Column="1" HeightRequest="22">
                                                            <BoxView AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                                                                     AbsoluteLayout.LayoutFlags="All"
                                                                     CornerRadius="{StaticResource BarRadius}"
                                                                     Color="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}" />
                                                            <BoxView AbsoluteLayout.LayoutBounds="{Binding FillBounds}"
                                                                     AbsoluteLayout.LayoutFlags="All"
                                                                     CornerRadius="{StaticResource BarRadius}"
                                                                     Color="{AppThemeBinding Light={StaticResource PrimaryLineLight}, Dark={StaticResource PrimaryLineDark}}">
                                                                <BoxView.Triggers>
                                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsBest}" Value="True">
                                                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                                                    </DataTrigger>
                                                                </BoxView.Triggers>
                                                            </BoxView>
                                                            <Label AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                                                                   AbsoluteLayout.LayoutFlags="All"
                                                                   Style="{StaticResource MiniLabel}"
                                                                   Padding="10,0"
                                                                   Text="{Binding Text}"
                                                                   VerticalTextAlignment="Center">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding IsBest}" Value="True">
                                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                        </AbsoluteLayout>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" ColumnDefinitions="*, 1.4*" ColumnSpacing="10" Padding="{markup:Gutter Top=14, Bottom=16}">
                <controls:TappableButton Style="{StaticResource SecondaryButton}"
                                         Text="{x:Static constants:UiText.ButtonHistory}"
                                         Command="{Binding ViewCompletedHistoryCommand}" />
                <controls:TappableButton Grid.Column="1"
                                         Style="{StaticResource PrimaryButton}"
                                         Text="{x:Static constants:UiText.ButtonDone}"
                                         Command="{Binding ExitWorkoutCommand}" />
            </Grid>
        </Grid>

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding SetActions.IsActionSheetOpen}">
            <controls:ItemActionsSheet Title="{Binding SetActions.ActionSetTitle}"
                                       Subtitle="{Binding SetActions.ActionSetSubtitle}"
                                       EditText="{x:Static constants:UiText.TitleEditSet}"
                                       DeleteText="{x:Static constants:UiText.TitleDeleteSet}"
                                       EditCommand="{Binding SetActions.EditCommand}"
                                       DeleteCommand="{Binding SetActions.DeleteCommand}"
                                       CancelCommand="{Binding SetActions.CancelCommand}" />
        </controls:BottomSheet>

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding SetActions.IsEditorOpen}">
            <controls:SetEditorSheet Title="{x:Static constants:UiText.TitleEditSet}" Editor="{Binding SetActions.Editor}" />
            <controls:BottomSheet.Footer>
                <controls:SheetActionBar ConfirmText="{x:Static constants:UiText.ButtonSave}"
                                         ConfirmCommand="{Binding SetActions.SaveEditorCommand}"
                                         CancelCommand="{Binding SetActions.CloseEditorCommand}" />
            </controls:BottomSheet.Footer>
        </controls:BottomSheet>
    </Grid>

</controls:BackNavigationPage>
