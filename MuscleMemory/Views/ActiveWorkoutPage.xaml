<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:constants="clr-namespace:MuscleMemory.Constants"
             x:Class="MuscleMemory.Views.ActiveWorkoutPage"
             x:DataType="viewmodels:ActiveWorkoutViewModel"
             Title="Workout"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             BackCommand="{Binding ExitWorkoutCommand}">

        <Grid>
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto" Padding="20" IsVisible="{Binding IsWorkoutCompleted, Converter={StaticResource InvertedBoolConverter}}">

                        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,10" HorizontalOptions="Center">
                <Label Text="{Binding WorkoutTitle}"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding TimerText}"
                       FontSize="48"
                       TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

                        <Grid Grid.Row="1" 
                  ColumnDefinitions="50, *, 50"
                  Margin="0,0,0,10"
                  IsVisible="{Binding IsExercisesEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <controls:TappableButton Grid.Column="0"
                                         Text="&lt;"
                                         Command="{Binding PreviousExerciseCommand}"
                                         IsEnabled="{Binding HasPreviousExercise}"
                                         DisabledOpacity="0"
                                         TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                         FontSize="24"
                                         VerticalOptions="Center" />
                <Border Grid.Column="1"
                        HorizontalOptions="Center"
                        Padding="20,8"
                        Stroke="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                        StrokeThickness="1.5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>
                    <Label Text="{Binding ExerciseProgressText}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>
                </Border>
                <controls:TappableButton Grid.Column="2"
                                         Text="&gt;"
                                         Command="{Binding NextExerciseCommand}"
                                         IsEnabled="{Binding HasNextExercise}"
                                         DisabledOpacity="0"
                                         TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                         FontSize="24"
                                         VerticalOptions="Center" />
            </Grid>

                        <VerticalStackLayout Grid.Row="2" Spacing="4" HorizontalOptions="Center" Margin="0,0,0,20">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" IsVisible="{Binding IsSetCounterVisible}">
                    <Label Text="{Binding SetProgressText}"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                           VerticalOptions="Center"/>
                    <ContentView BindingContext="{Binding CurrentExercise}" x:DataType="models:WorkoutExercise" VerticalOptions="Center">
                        <controls:Chip Text="{Binding TargetRPE, StringFormat='Target RPE: {0}', FallbackValue=0, TargetNullValue=0}" />
                    </ContentView>
                </HorizontalStackLayout>
            </VerticalStackLayout>

                        <Grid Grid.Row="3" Margin="0,0,0,20">
                                <VerticalStackLayout Spacing="20" IsVisible="{Binding IsExerciseComplete, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="Weight (kg)" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalOptions="Center"/>
                            <Border Style="{StaticResource FormField}" Padding="0" HeightRequest="60">
                                <Entry Text="{Binding WeightInput}" Keyboard="Numeric" FontSize="20" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Label Text="Reps" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalOptions="Center"/>
                            <Border Style="{StaticResource FormField}" Padding="0" HeightRequest="60">
                                <Entry Text="{Binding RepsInput}" Keyboard="Numeric" FontSize="20" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                                                <Label Grid.Row="0"
                               Text="{Binding LastSessionResultsText}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,15" />

                        <controls:TappableButton Grid.Row="1"
                                                 Style="{StaticResource PrimaryButton}"
                                                 Text="Save Set"
                                                 Command="{Binding SaveSetCommand}"
                                                 IsVisible="{Binding HasSavedSets, Converter={StaticResource InvertedBoolConverter}}" />

                        <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasSavedSets}" Grid.Row="1">
                            <controls:TappableButton Grid.Column="0"
                                                     Text="Undo Last"
                                                     Command="{Binding UndoLastSetCommand}"
                                                     TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                                     StrokeColor="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}"
                                                     StrokeThickness="1.5"
                                                     HeightRequest="60"
                                                     Margin="0,0,10,0" />
                            
                            <controls:TappableButton Grid.Column="1"
                                                     Style="{StaticResource PrimaryButton}"
                                                     Text="Save Set"
                                                     Command="{Binding SaveSetCommand}"
                                                     Margin="10,0,0,0" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
                
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsExerciseComplete}">
                    <Label Text="All Sets Completed! 🎉" 
                           FontSize="20" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" 
                           HorizontalOptions="Center" />
                    <Label Text="Ready for the next exercise." 
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" StrokeThickness="2"
                        Padding="20" HorizontalOptions="Fill" VerticalOptions="Fill"
                        IsVisible="{Binding IsResting}" Shadow="{StaticResource CardShadow}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="REST" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalOptions="Center" />
                        <Label Text="{Binding RestTimerText}" FontSize="48" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" HorizontalOptions="Center" />
                        <controls:TappableButton Text="Skip Rest"
                                                 Command="{Binding SkipRestCommand}"
                                                 TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                                 StrokeColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                                 StrokeThickness="1.5"
                                                 HeightRequest="50"
                                                 WidthRequest="150" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

                                    <Grid Grid.Row="4" Margin="0,20,0,0">

                                <CollectionView ItemsSource="{Binding CurrentSets}"
                                IsVisible="{Binding HasSavedSets}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkoutSet">
                            <SwipeView>
                                                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActiveWorkoutViewModel}}, Path=DeleteSetCommand}"
                                                       CommandParameter="{Binding .}">
                                            <controls:SwipeAction Style="{StaticResource DeleteSwipeAction}" />
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActiveWorkoutViewModel}}, Path=EditLoggedSetCommand}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding SetNumber, StringFormat='Set {0}'}"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                               VerticalOptions="Center"/>
                                        <Label Grid.Column="2" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Weight}" />
                                                    <Span Text="{x:Static constants:UiText.KgTimesSeparator}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                                    <Span Text="{Binding Reps}" />
                                                    <Span Text="{x:Static constants:UiText.RepsSuffix}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                                <controls:EmptyState Message="No sets saved yet"
                                     Detail="Enter weight and reps above, then tap Save Set."
                                     IsVisible="{Binding HasSavedSets, Converter={StaticResource InvertedBoolConverter}}" />

            </Grid>

        <controls:TappableButton Grid.Row="5"
                                 Text="Finish Workout"
                                 Command="{Binding FinishWorkoutCommand}"
                                 FillColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}"
                                 TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                 StrokeColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                 StrokeThickness="2"
                                 HeightRequest="60"
                                 Margin="0,10,0,0"
                                 SurfaceShadow="{StaticResource CardShadow}" />
        </Grid>

                <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}" IsVisible="{Binding IsWorkoutCompleted}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Workout Complete! 🎉" 
                           FontSize="36" 
                           TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" />
                    
                    <Label Text="{Binding WorkoutTitle, StringFormat='You finished {0}'}" 
                           FontSize="20" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                           HorizontalOptions="Center" />

                                        <Border Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource SubtleSurfaceBackgroundLight}, Dark={StaticResource SubtleSurfaceBackgroundDark}}" Margin="0,10,0,0" Shadow="{StaticResource CardShadow}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding TimerText, StringFormat='⏱ Total Time: {0}'}" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Text="{Binding TotalVolume, StringFormat='🏋️ Total Volume: {0} kg'}" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Best Sets" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" Margin="0,10,0,0" />
                    
                    <CollectionView ItemsSource="{Binding BestSets}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ExerciseBestSet">
                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="{Binding ExerciseName}" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding BestSetText}" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <controls:TappableButton Style="{StaticResource PrimaryButton}"
                                             Text="Finish &amp; Save Workout"
                                             Command="{Binding ExitWorkoutCommand}"
                                             WidthRequest="250"
                                             Margin="0,20,0,40" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</controls:BackNavigationPage>
