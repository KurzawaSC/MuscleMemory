<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:constants="clr-namespace:MuscleMemory.Constants"
             x:Class="MuscleMemory.Views.ActiveWorkoutPage"
             x:DataType="viewmodels:ActiveWorkoutViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
             BackCommand="{Binding NavigateBackCommand}">

    <Grid RowDefinitions="Auto, *">
        <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,10,20,0" IsVisible="{Binding IsWorkoutCompleted, Converter={StaticResource InvertedBoolConverter}}">
            <controls:GlyphButton Glyph="‹"
                                  Style="{StaticResource NavigationGlyphButton}"
                                  Command="{Binding NavigateBackCommand}" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Style="{StaticResource CaptionLabel}"
                       FontSize="13"
                       Text="{Binding WorkoutTitle}"
                       LineBreakMode="TailTruncation"
                       HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource TimerLabel}"
                       FontSize="40"
                       Text="{Binding TimerText}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <controls:TappableButton Grid.Column="2"
                                     Style="{StaticResource SoftPrimaryButton}"
                                     Text="Finish"
                                     FontSize="13"
                                     HeightRequest="36"
                                     CornerRadius="{StaticResource SmallControlRadius}"
                                     ContentPadding="12,0"
                                     VerticalOptions="Center"
                                     Command="{Binding FinishWorkoutCommand}"
                                     IsVisible="{Binding IsWorkoutCompleted, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

        <Grid Grid.Row="1"
              RowDefinitions="Auto, Auto, *, Auto"
              RowSpacing="14"
              Padding="20,16,20,12"
              IsVisible="{Binding IsWorkoutCompleted, Converter={StaticResource InvertedBoolConverter}}">

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsExercisesEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <FlexLayout BindableLayout.ItemsSource="{Binding SetSegments}"
                            IsVisible="{Binding IsResting, Converter={StaticResource InvertedBoolConverter}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LevelSegment">
                            <BoxView FlexLayout.Grow="1"
                                     FlexLayout.Basis="0"
                                     Margin="3,0"
                                     HeightRequest="4"
                                     CornerRadius="2"
                                     Color="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsFilled}" Value="True">
                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Style="{StaticResource TitleLabel}"
                               Text="{Binding CurrentExercise.ExerciseName, FallbackValue=''}"
                               LineBreakMode="TailTruncation" />
                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding ProgressCaption}" />
                    </VerticalStackLayout>
                    <controls:GlyphButton Grid.Column="1"
                                          Glyph="‹"
                                          Style="{StaticResource NavigationGlyphButton}"
                                          SurfaceSize="34"
                                          Command="{Binding PreviousExerciseCommand}"
                                          IsVisible="{Binding HasPreviousExercise}" />
                    <controls:GlyphButton Grid.Column="2"
                                          Glyph="›"
                                          Style="{StaticResource NavigationGlyphButton}"
                                          SurfaceSize="34"
                                          Command="{Binding NextExerciseCommand}"
                                          IsVisible="{Binding HasNextExercise}" />
                </Grid>
            </VerticalStackLayout>

            <Grid Grid.Row="1">
                <Border Style="{StaticResource SurfaceCard}" Padding="0">
                    <Border.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                            <Binding Path="IsResting" Converter="{StaticResource InvertedBoolConverter}" />
                            <Binding Path="IsExerciseComplete" Converter="{StaticResource InvertedBoolConverter}" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <VerticalStackLayout Spacing="14" Padding="16">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Style="{StaticResource OverlineLabel}" Text="{Binding TargetText}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource CaptionLabel}"
                                   Text="{Binding LastSessionResultsText}"
                                   LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="End">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasLastSession}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <controls:InputStepper Title="Weight (kg)"
                                                   Text="{Binding WeightInput}"
                                                   DecrementCommand="{Binding DecreaseWeightCommand}"
                                                   IncrementCommand="{Binding IncreaseWeightCommand}" />
                            <controls:InputStepper Grid.Column="1"
                                                   Title="Reps"
                                                   Text="{Binding RepsInput}"
                                                   DecrementCommand="{Binding DecreaseRepsCommand}"
                                                   IncrementCommand="{Binding IncreaseRepsCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *">
                            <controls:TappableButton Style="{StaticResource SecondaryButton}"
                                                     Text="Undo"
                                                     WidthRequest="120"
                                                     Margin="0,0,10,0"
                                                     Command="{Binding UndoLastSetCommand}"
                                                     IsVisible="{Binding HasSavedSets}" />
                            <controls:TappableButton Grid.Column="1"
                                                     Style="{StaticResource PrimaryButton}"
                                                     Text="Save set"
                                                     Command="{Binding SaveSetCommand}"
                                                     IsEnabled="{Binding CanSaveSet}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource RestPanel}" IsVisible="{Binding IsResting}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource OverlineLabel}"
                               Text="Rest"
                               TextColor="{AppThemeBinding Light={StaticResource OnRestPanelMutedLight}, Dark={StaticResource OnRestPanelMutedDark}}"
                               HorizontalTextAlignment="Center" />
                        <Grid WidthRequest="150" HeightRequest="150" Margin="0,14,0,6" HorizontalOptions="Center">
                            <controls:RestRing Progress="{Binding RestProgress}"
                                               Thickness="13"
                                               ProgressColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                               TrackColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Style="{StaticResource TimerLabel}"
                                       FontSize="40"
                                       Text="{Binding RestTimerText}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}"
                                       HorizontalTextAlignment="Center" />
                                <Label Style="{StaticResource CaptionLabel}"
                                       Text="{Binding RestTotalText}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnRestPanelMutedLight}, Dark={StaticResource OnRestPanelMutedDark}}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,14,0,0">
                            <controls:TappableButton Text="+30 s"
                                                     FontSize="15"
                                                     HeightRequest="46"
                                                     CornerRadius="{StaticResource ControlRadius}"
                                                     FillColor="{AppThemeBinding Light={StaticResource OnRestPanelSubtleLight}, Dark={StaticResource OnRestPanelSubtleDark}}"
                                                     TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}"
                                                     Command="{Binding ExtendRestCommand}" />
                            <controls:TappableButton Grid.Column="1"
                                                     Style="{StaticResource PrimaryButton}"
                                                     Text="Skip rest"
                                                     FontSize="15"
                                                     HeightRequest="46"
                                                     Shadow="{x:Null}"
                                                     Command="{Binding SkipRestCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SurfaceCard}">
                    <Border.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                            <Binding Path="IsResting" Converter="{StaticResource InvertedBoolConverter}" />
                            <Binding Path="IsExerciseComplete" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource TitleLabel}"
                               Text="All sets done"
                               HorizontalTextAlignment="Center" />
                        <Label Style="{StaticResource CaptionLabel}"
                               Text="Move on to the next exercise or finish the workout."
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <ScrollView Grid.Row="2" IsVisible="{Binding HasSavedSets}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource OverlineLabel}" Text="This session">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsResting}" Value="True">
                                <Setter Property="Text" Value="Logged sets" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border Style="{StaticResource SurfaceCard}" Padding="14,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource ControlRadius}" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentSets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutSet">
                                        <VerticalStackLayout BackgroundColor="Transparent">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActiveWorkoutViewModel}}, Path=ShowSetActionsCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <Grid ColumnDefinitions="*, Auto" Padding="0,12">
                                                <Label Style="{StaticResource CaptionLabel}"
                                                       FontSize="13"
                                                       Text="{Binding SetNumber, StringFormat={x:Static constants:UiText.SetProgressFormat}}" />
                                                <Label Grid.Column="1" FontSize="14">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{x:Static constants:UiText.LoggedSetFormat}">
                                                            <Binding Path="Weight" />
                                                            <Binding Path="Reps" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </Grid>
                                            <BoxView Style="{StaticResource Divider}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*, Auto" Padding="0,12">
                                <Label Style="{StaticResource CaptionLabel}" FontSize="13" Text="Volume" />
                                <Label Grid.Column="1" FontSize="14" Text="{Binding CurrentVolumeText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2"
                                 Spacing="10"
                                 Padding="20,0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <VerticalStackLayout.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                        <Binding Path="HasSavedSets" Converter="{StaticResource InvertedBoolConverter}" />
                        <Binding Path="IsResting" Converter="{StaticResource InvertedBoolConverter}" />
                    </MultiBinding>
                </VerticalStackLayout.IsVisible>
                <Border Style="{StaticResource SurfaceCard}"
                        WidthRequest="64"
                        HeightRequest="64"
                        Padding="0"
                        Shadow="{x:Null}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Label Style="{StaticResource TitleLabel}"
                           Text="1"
                           TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Style="{StaticResource CaptionLabel}"
                       FontSize="13"
                       Text="First time doing this exercise. Enter weight and reps — next time we will prefill your last session."
                       HorizontalTextAlignment="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasLastSession}" Value="True">
                            <Setter Property="Text" Value="Weight and reps are prefilled from your last session." />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <controls:TappableButton Grid.Row="3"
                                     Style="{StaticResource DangerOutlineButton}"
                                     Text="Finish workout"
                                     HeightRequest="52"
                                     Command="{Binding FinishWorkoutCommand}" />
        </Grid>

        <Grid Grid.RowSpan="2" RowDefinitions="*, Auto" IsVisible="{Binding IsWorkoutCompleted}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,0" Spacing="4">
                    <Label Style="{StaticResource OverlineLabel}"
                           Text="Workout complete"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Style="{StaticResource DisplayLabel}" Text="{Binding WorkoutTitle}" />
                    <Label Style="{StaticResource CaptionLabel}" FontSize="13" Text="{Binding SummaryDateText}" />

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10" Margin="0,12,0,0">
                        <Border Style="{StaticResource SurfaceCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource ValueLabel}" Text="{Binding TotalTimeText}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="time" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label LineBreakMode="NoWrap">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding TotalVolume, StringFormat={x:Static constants:UiText.VolumeNumberFormat}}"
                                                  FontSize="24"
                                                  TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                            <Span Text=" kg"
                                                  FontSize="12"
                                                  TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Style="{StaticResource CaptionLabel}" Text="volume" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource ValueLabel}" Text="{Binding TotalSets}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding TotalSetsCaption}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Style="{StaticResource OverlineLabel}" Text="Exercises" Margin="0,18,0,6" />

                    <VerticalStackLayout Spacing="10" Margin="0,0,0,14" BindableLayout.ItemsSource="{Binding CompletedExercises}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SummaryExerciseItem">
                                <Border Style="{StaticResource SurfaceCard}" Padding="16,14">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <Label Style="{StaticResource TitleLabel}"
                                                   FontSize="17"
                                                   Text="{Binding ExerciseName}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1"
                                                   FontSize="12"
                                                   Text="{Binding VolumeText}"
                                                   TextColor="{AppThemeBinding Light={StaticResource InkBodyLight}, Dark={StaticResource InkBodyDark}}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Sets}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:SummarySetBar">
                                                    <Grid ColumnDefinitions="14, *" ColumnSpacing="10">
                                                        <Label FontSize="11"
                                                               Text="{Binding SetNumber}"
                                                               TextColor="{AppThemeBinding Light={StaticResource InkFaintLight}, Dark={StaticResource InkFaintDark}}"
                                                               VerticalOptions="Center" />
                                                        <AbsoluteLayout Grid.Column="1" HeightRequest="22">
                                                            <BoxView AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                                                                     AbsoluteLayout.LayoutFlags="All"
                                                                     CornerRadius="7"
                                                                     Color="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}" />
                                                            <BoxView AbsoluteLayout.LayoutBounds="{Binding FillBounds}"
                                                                     AbsoluteLayout.LayoutFlags="All"
                                                                     CornerRadius="7"
                                                                     Color="{AppThemeBinding Light={StaticResource PrimaryLineLight}, Dark={StaticResource PrimaryLineDark}}">
                                                                <BoxView.Triggers>
                                                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsBest}" Value="True">
                                                                        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                                                    </DataTrigger>
                                                                </BoxView.Triggers>
                                                            </BoxView>
                                                            <Label AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                                                                   AbsoluteLayout.LayoutFlags="All"
                                                                   Padding="10,0"
                                                                   FontSize="12"
                                                                   Text="{Binding Text}"
                                                                   VerticalTextAlignment="Center">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding IsBest}" Value="True">
                                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                        </AbsoluteLayout>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" ColumnDefinitions="*, 1.4*" ColumnSpacing="10" Padding="20,14,20,16">
                <controls:TappableButton Style="{StaticResource SecondaryButton}"
                                         Text="History"
                                         HeightRequest="52"
                                         Command="{Binding ViewCompletedHistoryCommand}" />
                <controls:TappableButton Grid.Column="1"
                                         Style="{StaticResource PrimaryButton}"
                                         Text="Done"
                                         HeightRequest="52"
                                         Command="{Binding ExitWorkoutCommand}" />
            </Grid>
        </Grid>

        <controls:BottomSheet Grid.RowSpan="2" IsOpen="{Binding IsSetActionSheetOpen}">
            <controls:ItemActionsSheet Title="{Binding ActionSetTitle}"
                                       Subtitle="{Binding ActionSetSubtitle}"
                                       EditText="Edit set"
                                       DeleteText="Delete set"
                                       EditCommand="{Binding EditActionSetCommand}"
                                       DeleteCommand="{Binding DeleteActionSetCommand}"
                                       CancelCommand="{Binding CancelSetActionsCommand}" />
        </controls:BottomSheet>
    </Grid>

</controls:BackNavigationPage>
