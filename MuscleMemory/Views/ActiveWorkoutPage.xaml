<?xml version="1.0" encoding="utf-8" ?>
<controls:BackNavigationPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Views.ActiveWorkoutPage"
             x:DataType="viewmodels:ActiveWorkoutViewModel"
             Title="Workout"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             BackCommand="{Binding ExitWorkoutCommand}">

        <Grid>
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto" Padding="20" IsVisible="{Binding IsWorkoutCompleted, Converter={StaticResource InvertedBoolConverter}}">

                        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,10" HorizontalOptions="Center">
                <Label Text="{Binding WorkoutTitle}"
                       FontSize="24"
                       FontFamily="LilitaOne"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding TimerText}"
                       FontSize="48"
                       FontFamily="LilitaOne"
                       TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

                        <Grid Grid.Row="1" 
                  ColumnDefinitions="50, *, 50"
                  Margin="0,0,0,10"
                  IsVisible="{Binding IsExercisesEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <Button Grid.Column="0" 
                        Text="&lt;" 
                        Command="{Binding PreviousExerciseCommand}"
                        IsEnabled="{Binding HasPreviousExercise}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                        FontFamily="LilitaOne"
                        FontSize="24"
                        VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding HasPreviousExercise}" Value="False">
                            <Setter Property="Opacity" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Border Grid.Column="1"
                        HorizontalOptions="Center"
                        Padding="20,8"
                        Stroke="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                        StrokeThickness="1.5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label Text="{Binding ExerciseProgressText}"
                           FontFamily="LilitaOne"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>
                </Border>
                <Button Grid.Column="2" 
                        Text="&gt;" 
                        Command="{Binding NextExerciseCommand}"
                        IsEnabled="{Binding HasNextExercise}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                        FontFamily="LilitaOne"
                        FontSize="24"
                        VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding HasNextExercise}" Value="False">
                            <Setter Property="Opacity" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

                        <VerticalStackLayout Grid.Row="2" Spacing="4" HorizontalOptions="Center" Margin="0,0,0,20">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" IsVisible="{Binding IsSetCounterVisible}">
                    <Label Text="{Binding SetProgressText}"
                           FontSize="16"
                           FontFamily="LilitaOne"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                           VerticalOptions="Center"/>
                    <ContentView BindingContext="{Binding CurrentExercise}" x:DataType="models:WorkoutExercise" VerticalOptions="Center">
                        <controls:Chip Text="{Binding TargetRPE, StringFormat='Target RPE: {0}', FallbackValue=0, TargetNullValue=0}" />
                    </ContentView>
                </HorizontalStackLayout>
            </VerticalStackLayout>

                        <Grid Grid.Row="3" Margin="0,0,0,20">
                                <VerticalStackLayout Spacing="20" IsVisible="{Binding IsExerciseComplete, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <VerticalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="Weight (kg)" FontSize="16" FontFamily="LilitaOne" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalOptions="Center"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" HeightRequest="60" Shadow="{StaticResource CardShadow}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding WeightInput}" Keyboard="Numeric" FontSize="20" FontFamily="LilitaOne" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Label Text="Reps" FontSize="16" FontFamily="LilitaOne" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalOptions="Center"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" HeightRequest="60" Shadow="{StaticResource CardShadow}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding RepsInput}" Keyboard="Numeric" FontSize="20" FontFamily="LilitaOne" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                                                <Label Grid.Row="0"
                               Text="{Binding LastSessionResultsText}"
                               FontSize="14"
                               FontFamily="LilitaOne"
                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,15" />

                                                <Button Grid.Row="1"
                                Text="Save Set"
                                Command="{Binding SaveSetCommand}"
                                IsVisible="{Binding HasSavedSets, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                TextColor="{StaticResource OnAccentText}"
                                FontFamily="LilitaOne"
                                FontSize="20"
                                CornerRadius="30"
                                HeightRequest="60" Shadow="{StaticResource CardShadow}">
                        </Button>

                        <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasSavedSets}" Grid.Row="1">
                            <Button Grid.Column="0"
                                    Text="Undo Last"
                                    Command="{Binding UndoLastSetCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}"
                                    BorderWidth="1.5"
                                    FontFamily="LilitaOne"
                                    FontSize="18"
                                    CornerRadius="30"
                                    HeightRequest="60"
                                    Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1"
                                    Text="Save Set"
                                    Command="{Binding SaveSetCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                                    TextColor="{StaticResource OnAccentText}"
                                    FontFamily="LilitaOne"
                                    FontSize="20"
                                    CornerRadius="30"
                                    HeightRequest="60"
                                    Margin="10,0,0,0" Shadow="{StaticResource CardShadow}">
                            </Button>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
                
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsExerciseComplete}">
                    <Label Text="All Sets Completed! 🎉" 
                           FontSize="20" FontFamily="LilitaOne" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" 
                           HorizontalOptions="Center" />
                    <Label Text="Ready for the next exercise." 
                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" StrokeThickness="2"
                        Padding="20" HorizontalOptions="Fill" VerticalOptions="Fill"
                        IsVisible="{Binding IsResting}" Shadow="{StaticResource CardShadow}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="REST" FontFamily="LilitaOne" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" HorizontalOptions="Center" />
                        <Label Text="{Binding RestTimerText}" FontFamily="LilitaOne" FontSize="48" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" HorizontalOptions="Center" />
                        <Button Text="Skip Rest" Command="{Binding SkipRestCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" FontFamily="LilitaOne" FontSize="18" BorderColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" BorderWidth="1.5" CornerRadius="25" HeightRequest="50" WidthRequest="150" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

                                    <Grid Grid.Row="4" Margin="0,20,0,0">

                                <CollectionView ItemsSource="{Binding CurrentSets}"
                                IsVisible="{Binding HasSavedSets}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkoutSet">
                            <SwipeView>
                                                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActiveWorkoutViewModel}}, Path=DeleteSetCommand}"
                                                       CommandParameter="{Binding .}">
                                            <controls:SwipeAction Style="{StaticResource DeleteSwipeAction}" />
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Margin="0,0,0,10" Padding="15" Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" Shadow="{StaticResource CardShadow}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ActiveWorkoutViewModel}}, Path=EditLoggedSetCommand}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding SetNumber, StringFormat='Set {0}'}"
                                               FontFamily="LilitaOne"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                               VerticalOptions="Center"/>
                                        <Label Grid.Column="2" FontFamily="LilitaOne" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Weight}" />
                                                    <Span Text=" kg  ×  " TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                                    <Span Text="{Binding Reps}" />
                                                    <Span Text=" reps" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8"
                                     IsVisible="{Binding HasSavedSets, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="No sets saved yet"
                           FontFamily="LilitaOne"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Enter weight and reps above, then tap Save Set."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </Grid>

                        <Button Grid.Row="5"
                    Text="Finish Workout"
                    Command="{Binding FinishWorkoutCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
                    BorderColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" BorderWidth="2"
                    FontFamily="LilitaOne" FontSize="18" CornerRadius="30" HeightRequest="60"
                    Margin="0,10,0,0" Shadow="{StaticResource CardShadow}">
        </Button>
        </Grid>

                <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}" IsVisible="{Binding IsWorkoutCompleted}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Workout Complete! 🎉" 
                           FontSize="36" 
                           FontFamily="LilitaOne" 
                           TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" />
                    
                    <Label Text="{Binding WorkoutTitle, StringFormat='You finished {0}'}" 
                           FontSize="20" 
                           FontFamily="LilitaOne" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                           HorizontalOptions="Center" />

                                        <Border Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource SubtleSurfaceBackgroundLight}, Dark={StaticResource SubtleSurfaceBackgroundDark}}" Margin="0,10,0,0" Shadow="{StaticResource CardShadow}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding TimerText, StringFormat='⏱ Total Time: {0}'}" FontSize="18" FontFamily="LilitaOne" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Text="{Binding TotalVolume, StringFormat='🏋️ Total Volume: {0} kg'}" FontSize="18" FontFamily="LilitaOne" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Best Sets" FontSize="22" FontFamily="LilitaOne" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" Margin="0,10,0,0" />
                    
                    <CollectionView ItemsSource="{Binding BestSets}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ExerciseBestSet">
                                <Border Margin="0,0,0,10" Padding="15" Stroke="{AppThemeBinding Light={StaticResource StrokeColorLight}, Dark={StaticResource StrokeColorDark}}" StrokeThickness="1" Shadow="{StaticResource CardShadow}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="{Binding ExerciseName}" FontFamily="LilitaOne" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding BestSetText}" FontFamily="LilitaOne" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <Button Text="Finish &amp; Save Workout" 
                            Command="{Binding ExitWorkoutCommand}" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}" 
                            TextColor="{StaticResource OnAccentText}" 
                            FontFamily="LilitaOne" 
                            FontSize="20" 
                            CornerRadius="30" 
                            HeightRequest="60" 
                            Margin="0,20,0,40" 
                            WidthRequest="250" Shadow="{StaticResource CardShadow}">
                    </Button>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</controls:BackNavigationPage>
