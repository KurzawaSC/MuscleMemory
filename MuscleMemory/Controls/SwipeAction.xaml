<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.SwipeAction"
             x:Name="Root"
             x:DataType="controls:SwipeAction">

    <Border Margin="4,6"
            Padding="20,8"
            BackgroundColor="Transparent"
            StrokeThickness="1.5">
        <Border.Stroke>
            <SolidColorBrush Color="{Binding Tint, Source={x:Reference Root}}" />
        </Border.Stroke>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Label Text="{Binding Text, Source={x:Reference Root}}"
               TextColor="{Binding Tint, Source={x:Reference Root}}"
               FontSize="16"
               VerticalOptions="Center"
               HorizontalOptions="Center" />
    </Border>
</ContentView>
