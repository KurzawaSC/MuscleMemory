<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.SettingsActionRow"
             x:Name="Root"
             x:DataType="controls:SettingsActionRow">

    <Border Style="{StaticResource SettingsRow}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
            <Image Grid.Column="0"
                   Source="{Binding IconSource, Source={x:Reference Root}}"
                   InputTransparent="True"
                   HeightRequest="24"
                   WidthRequest="24"
                   Margin="0,0,15,0">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{Binding Tint, Source={x:Reference Root}}" />
                </Image.Behaviors>
            </Image>
            <Label Grid.Column="1"
                   Text="{Binding Text, Source={x:Reference Root}}"
                   TextColor="{Binding Tint, Source={x:Reference Root}}"
                   FontSize="18"
                   VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
