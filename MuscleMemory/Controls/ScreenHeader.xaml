<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:markup="clr-namespace:MuscleMemory.Markup"
             x:Class="MuscleMemory.Controls.ScreenHeader"
             x:Name="Root"
             x:DataType="controls:ScreenHeader"
             Padding="{markup:Gutter Top=14, Bottom=8}">

    <VerticalStackLayout Spacing="4">
        <Label Style="{StaticResource DisplayLabel}"
               Text="{Binding Title, Source={x:Reference Root}}" />
        <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
               IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}" />
    </VerticalStackLayout>
</ContentView>
