<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:constants="clr-namespace:MuscleMemory.Constants"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             x:Class="MuscleMemory.Controls.ExerciseFormSheet"
             x:Name="Root"
             x:DataType="controls:ExerciseFormSheet">

    <VerticalStackLayout Spacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Style="{StaticResource TitleLabel}" Text="{Binding Form.Title, Source={x:Reference Root}}" />
            <Label Style="{StaticResource CaptionLabel}" Text="{x:Static constants:UiText.HintExerciseForm}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.LabelName}" />
            <controls:TextField FieldHeight="52"
                                Text="{Binding Form.Name, Source={x:Reference Root}}"
                                ErrorText="{Binding Form.NameError, Source={x:Reference Root}, FallbackValue=''}"
                                MaxLength="{x:Static constants:DomainDefaults.MaxNameLength}"
                                Placeholder="{x:Static constants:UiText.PlaceholderExerciseName}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.LabelMuscleGroup}" />
            <FlexLayout Wrap="Wrap"
                        AlignContent="Start"
                        AlignItems="Start"
                        RadioButtonGroup.GroupName="ExerciseFormMuscleGroup"
                        RadioButtonGroup.SelectedValue="{Binding Form.SelectedMuscleGroup, Source={x:Reference Root}}"
                        BindableLayout.ItemsSource="{Binding Form.MuscleGroups, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:MuscleGroup">
                        <RadioButton Style="{StaticResource ChoiceChip}"
                                     Margin="0,0,4,4"
                                     Content="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}"
                                     Value="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Style="{StaticResource OverlineLabel}" Text="{x:Static constants:UiText.LabelEquipment}" />
            <FlexLayout Wrap="Wrap"
                        AlignContent="Start"
                        AlignItems="Start"
                        RadioButtonGroup.GroupName="ExerciseFormEquipment"
                        RadioButtonGroup.SelectedValue="{Binding Form.SelectedEquipment, Source={x:Reference Root}}"
                        BindableLayout.ItemsSource="{Binding Form.EquipmentTypes, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:EquipmentType">
                        <RadioButton Style="{StaticResource ChoiceChip}"
                                     Margin="0,0,4,4"
                                     Content="{Binding ., Converter={StaticResource EnumDisplayNameConverter}}"
                                     Value="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
