<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:loc="clr-namespace:MuscleMemory.Localization"
             x:Class="MuscleMemory.Controls.TextField"
             x:Name="Root"
             x:DataType="controls:TextField">

    <VerticalStackLayout Spacing="6">
        <Border x:Name="Field" Style="{StaticResource FormField}" HeightRequest="{Binding FieldHeight, Source={x:Reference Root}}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsFilled, Source={x:Reference Root}}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}" />
                    <Setter Property="Stroke" Value="Transparent" />
                </DataTrigger>
            </Border.Triggers>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState Name="{x:Static controls:FieldVisualStates.Idle}" />
                        <VisualState Name="{x:Static controls:FieldVisualStates.Invalid}">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLineLight}, Dark={StaticResource PrimaryLineDark}}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="{x:Static controls:FieldVisualStates.Editing}">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnDefinitions="*, Auto">
                <Entry x:Name="Input"
                       Text="{Binding Text, Source={x:Reference Root}}"
                       MaxLength="{Binding MaxLength, Source={x:Reference Root}}"
                       Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                       VerticalOptions="Center"
                       Focused="OnInputFocusChanged"
                       Unfocused="OnInputFocusChanged" />
                <Label Grid.Column="1"
                       Style="{StaticResource LargeGlyphLabel}"
                       Text="×"
                       WidthRequest="{StaticResource TouchTarget}"
                       HeightRequest="{StaticResource TouchTarget}"
                       Margin="0,-4,-12,-4"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       VerticalOptions="Center"
                       SemanticProperties.Description="{loc:Text ActionClearText}"
                       IsVisible="{Binding ShowsClearButton, Source={x:Reference Root}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClearTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>
        <Label Style="{StaticResource CaptionLabel}"
               Text="{Binding ErrorText, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
               IsVisible="{Binding HasError, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
