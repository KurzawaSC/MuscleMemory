<?xml version="1.0" encoding="utf-8" ?>
<Label xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:controls="clr-namespace:MuscleMemory.Controls"
       x:Class="MuscleMemory.Controls.UnitLabel"
       x:Name="Root"
       x:DataType="controls:UnitLabel"
       Style="{StaticResource BaseLabel}">
    <Label.FormattedText>
        <FormattedString>
            <Span Style="{Binding ValueSpanStyle, Source={x:Reference Root}}"
                  Text="{Binding DisplayValue, Source={x:Reference Root}}"
                  TextColor="{Binding ValueColor, Source={x:Reference Root}}" />
            <Span Style="{StaticResource UnitSpan}" Text="{Binding Unit, Source={x:Reference Root}}" />
        </FormattedString>
    </Label.FormattedText>
</Label>
