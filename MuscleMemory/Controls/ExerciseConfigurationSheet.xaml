<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:constants="clr-namespace:MuscleMemory.Constants"
             xmlns:loc="clr-namespace:MuscleMemory.Localization"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             x:Class="MuscleMemory.Controls.ExerciseConfigurationSheet"
             x:Name="Root"
             x:DataType="controls:ExerciseConfigurationSheet">

    <VerticalStackLayout Spacing="16">
        <controls:SheetItemHeader Title="{Binding Configuration.ExerciseName, Source={x:Reference Root}, FallbackValue=''}" />

        <VerticalStackLayout Spacing="10">
            <controls:ValueStepper Title="{loc:Text LabelSets}"
                                   Value="{Binding Configuration.Sets, Source={x:Reference Root}}"
                                   Minimum="{x:Static constants:DomainDefaults.MinSets}"
                                   Maximum="{x:Static constants:DomainDefaults.MaxSets}" />
            <controls:ValueStepper Title="{loc:Text LabelReps}"
                                   Value="{Binding Configuration.Reps, Source={x:Reference Root}}"
                                   Minimum="{x:Static constants:DomainDefaults.MinReps}"
                                   Maximum="{x:Static constants:DomainDefaults.MaxReps}" />

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <controls:InputStepper Title="{loc:Text LabelRepRangeFrom}"
                                           Description="{loc:Text DescriptionRepRangeFrom}"
                                           Text="{Binding Configuration.MinRepsInput, Source={x:Reference Root}}"
                                           ErrorText="{Binding Configuration.MinRepsError, Source={x:Reference Root}}"
                                           MaxLength="{x:Static constants:InputLimits.MaxRepRangeInputLength}"
                                           DecrementCommand="{Binding Configuration.DecreaseMinRepsCommand, Source={x:Reference Root}}"
                                           IncrementCommand="{Binding Configuration.IncreaseMinRepsCommand, Source={x:Reference Root}}" />
                    <controls:InputStepper Grid.Column="1"
                                           Title="{loc:Text LabelRepRangeTo}"
                                           Description="{loc:Text DescriptionRepRangeTo}"
                                           Text="{Binding Configuration.MaxRepsInput, Source={x:Reference Root}}"
                                           ErrorText="{Binding Configuration.MaxRepsError, Source={x:Reference Root}}"
                                           MaxLength="{x:Static constants:InputLimits.MaxRepRangeInputLength}"
                                           DecrementCommand="{Binding Configuration.DecreaseMaxRepsCommand, Source={x:Reference Root}}"
                                           IncrementCommand="{Binding Configuration.IncreaseMaxRepsCommand, Source={x:Reference Root}}" />
                </Grid>
                <Label Style="{StaticResource CaptionLabel}" Text="{loc:Text CaptionRepRange}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource InsetPanel}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{loc:Text LabelRest}" />
                        <Label Grid.Column="1"
                               Text="{Binding Configuration.BreakTimeText, Source={x:Reference Root}}"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </Grid>
                    <FlexLayout RadioButtonGroup.GroupName="RestPresets"
                                RadioButtonGroup.SelectedValue="{Binding Configuration.SelectedRestPreset, Source={x:Reference Root}}"
                                BindableLayout.ItemsSource="{Binding Configuration.RestPresets, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:RestPreset">
                                <RadioButton Style="{StaticResource SegmentChip}"
                                             FlexLayout.Grow="1"
                                             FlexLayout.Basis="0"
                                             Margin="2,0"
                                             Content="{Binding Label}"
                                             Value="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <controls:ValueStepper Title="{loc:Text LabelCustom}"
                                           IsVisible="{Binding Configuration.IsCustomRest, Source={x:Reference Root}, FallbackValue=False}"
                                           Value="{Binding Configuration.BreakTimeInSeconds, Source={x:Reference Root}}"
                                           Minimum="{x:Static constants:DomainDefaults.MinBreakTimeInSeconds}"
                                           Maximum="{x:Static constants:DomainDefaults.MaxBreakTimeInSeconds}"
                                           Step="{x:Static constants:DomainDefaults.BreakTimeStepInSeconds}"
                                           ValueFormat="{loc:Text RestDurationFormat}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource InsetPanel}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{loc:Text LabelTargetRpe}" />
                        <Label Grid.Column="1"
                               Text="{Binding Configuration.TargetRPE, Source={x:Reference Root}}"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </Grid>
                    <controls:LevelBar Segments="{Binding Configuration.RpeLevels, Source={x:Reference Root}}"
                                       SegmentHeight="8"
                                       SegmentRadius="{StaticResource LevelBarRadius}"
                                       SegmentInset="2.5,0"
                                       SelectCommand="{Binding Configuration.SelectRpeCommand, Source={x:Reference Root}}" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Style="{StaticResource CaptionLabel}" Text="{loc:Text LabelRpeEasy}" />
                        <Label Grid.Column="1" Style="{StaticResource CaptionLabel}" Text="{loc:Text LabelRpeMax}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <controls:TappableButton Style="{StaticResource SmallTextButton}"
                                 Text="{loc:Text ButtonRemoveFromWorkout}"
                                 HorizontalOptions="Center"
                                 IsVisible="{Binding Configuration.IsEditing, Source={x:Reference Root}, FallbackValue=False}"
                                 Command="{Binding RemoveCommand, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
