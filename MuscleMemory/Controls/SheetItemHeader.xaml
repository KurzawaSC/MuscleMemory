<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.SheetItemHeader"
             x:Name="Root"
             x:DataType="controls:SheetItemHeader">

    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
        <Border WidthRequest="44"
                HeightRequest="44"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{StaticResource SmallControlRadius}" />
            </Border.StrokeShape>
            <Label Text="{Binding Title, Source={x:Reference Root}, Converter={StaticResource InitialsConverter}}"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
            <Label Style="{StaticResource TitleLabel}"
                   Text="{Binding Title, Source={x:Reference Root}}"
                   LineBreakMode="TailTruncation" />
            <Label Style="{StaticResource CaptionLabel}"
                   Text="{Binding Subtitle, Source={x:Reference Root}}"
                   IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
