<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:markup="clr-namespace:MuscleMemory.Markup"
             x:Class="MuscleMemory.Controls.BottomSheet"
             x:Name="Root"
             x:DataType="controls:BottomSheet"
             IsVisible="False">

    <ContentView.Content>
        <Grid x:Name="Layer">
            <BoxView x:Name="Scrim"
                     Opacity="0"
                     Color="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrimTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="Sheet"
                    VerticalOptions="End"
                    Padding="{markup:Gutter Top=12, Bottom=24}"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Shadow="{StaticResource SheetShadow}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource SheetRadius}" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Border.GestureRecognizers>
                <VerticalStackLayout x:Name="SheetLayout" Spacing="14">
                    <BoxView x:Name="GrabHandle"
                             WidthRequest="40"
                             HeightRequest="4"
                             CornerRadius="{StaticResource IndicatorRadius}"
                             HorizontalOptions="Center"
                             Color="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}" />
                    <ScrollView x:Name="Body" Orientation="Neither" VerticalScrollBarVisibility="Never">
                        <ContentView x:Name="BodyContent" Content="{Binding SheetContent, Source={x:Reference Root}}" />
                    </ScrollView>
                    <ContentView x:Name="FooterHost"
                                 Margin="0,2,0,0"
                                 IsVisible="False"
                                 Content="{Binding Footer, Source={x:Reference Root}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ContentView.Content>
</ContentView>
