<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:constants="clr-namespace:MuscleMemory.Constants"
             xmlns:markup="clr-namespace:MuscleMemory.Markup"
             x:Class="MuscleMemory.Controls.ResumeWorkoutBanner"
             x:Name="Root"
             x:DataType="controls:ResumeWorkoutBanner"
             Margin="{markup:Gutter Bottom=20}"
             HorizontalOptions="Fill"
             VerticalOptions="End"
             IsVisible="{Binding ActiveWorkout.IsBannerVisible, Source={x:Reference Root}}">

    <Border Padding="16"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
            Shadow="{StaticResource CardShadow}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource BannerRadius}" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ActiveWorkout.ResumeWorkoutCommand, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Label Style="{StaticResource EmphasisLabel}"
               Text="{x:Static constants:UiText.BannerResumeWorkout}"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}"
               VerticalOptions="Center" />
    </Border>
</ContentView>
