<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.ResumeWorkoutBanner"
             x:Name="Root"
             x:DataType="controls:ResumeWorkoutBanner"
             Margin="15,0,15,20"
             HorizontalOptions="Fill"
             VerticalOptions="End"
             IsVisible="{Binding ActiveWorkout.IsBannerVisible, Source={x:Reference Root}}">

    <Border Padding="16"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
            Shadow="{StaticResource CardShadow}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ActiveWorkout.ResumeWorkoutCommand, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Label Text="Workout in Progress - Tap to Resume"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource OnAccentText}"
               FontSize="16"
               VerticalOptions="Center" />
    </Border>
</ContentView>
