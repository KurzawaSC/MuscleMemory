<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.Chip"
             x:Name="Root"
             x:DataType="controls:Chip">

    <Border Padding="10,5"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource ChipRadius}" />
        </Border.StrokeShape>
        <Label Text="{Binding Text, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource InkBodyLight}, Dark={StaticResource InkBodyDark}}"
               FontSize="12" />
    </Border>
</ContentView>
