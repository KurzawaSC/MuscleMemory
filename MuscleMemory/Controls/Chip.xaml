<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.Chip"
             x:Name="Root"
             x:DataType="controls:Chip">

    <Border Padding="10,5"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsAccent, Source={x:Reference Root}}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource ChipRadius}" />
        </Border.StrokeShape>
        <Label Text="{Binding Text, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource InkBodyLight}, Dark={StaticResource InkBodyDark}}"
               FontSize="12">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsAccent, Source={x:Reference Root}}" Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>
</ContentView>
