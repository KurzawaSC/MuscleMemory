<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:constants="clr-namespace:MuscleMemory.Constants"
             x:Class="MuscleMemory.Controls.SetTableHeader">

    <Grid Style="{StaticResource SetTableRow}"
          Padding="12,8"
          BackgroundColor="{AppThemeBinding Light={StaticResource InsetFillLight}, Dark={StaticResource InsetFillDark}}">
        <Label Style="{StaticResource SmallOverlineLabel}" Text="{x:Static constants:UiText.LabelSet}" />
        <Label Grid.Column="1" Style="{StaticResource SmallOverlineLabel}" Text="{x:Static constants:UiText.LabelWeight}" HorizontalTextAlignment="Center" />
        <Label Grid.Column="2" Style="{StaticResource SmallOverlineLabel}" Text="{x:Static constants:UiText.LabelReps}" HorizontalTextAlignment="End" />
    </Grid>
</ContentView>
