<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MuscleMemory.Controls.SetTableHeader">

    <Grid ColumnDefinitions="*,*,*"
          Padding="8"
          BackgroundColor="{AppThemeBinding Light={StaticResource TableHeaderBackgroundLight}, Dark={StaticResource TableHeaderBackgroundDark}}">
        <Label Grid.Column="0" Text="Set" FontSize="12" HorizontalTextAlignment="Center" />
        <Label Grid.Column="1" Text="Weight (kg)" FontSize="12" HorizontalTextAlignment="Center" />
        <Label Grid.Column="2" Text="Reps" FontSize="12" HorizontalTextAlignment="Center" />
    </Grid>
</ContentView>
