<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.FloatingActionButton"
             x:Name="Root"
             x:DataType="controls:FloatingActionButton"
             Margin="20"
             HeightRequest="60"
             WidthRequest="60"
             HorizontalOptions="End"
             VerticalOptions="End">

    <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentRedLight}, Dark={StaticResource AccentRedDark}}"
            StrokeThickness="0"
            Shadow="{StaticResource CardShadow}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="30" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Image Source="plus_icon.png"
               WidthRequest="24"
               HeightRequest="24"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               InputTransparent="True">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{StaticResource OnAccentText}" />
            </Image.Behaviors>
        </Image>
    </Border>
</ContentView>
