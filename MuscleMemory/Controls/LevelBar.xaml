<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             x:Class="MuscleMemory.Controls.LevelBar"
             x:Name="Root"
             x:DataType="controls:LevelBar">

    <ContentView.Resources>
        <Style x:Key="LevelSegmentBar" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="{Binding SegmentHeight, Source={RelativeSource AncestorType={x:Type controls:LevelBar}}, x:DataType=controls:LevelBar}" />
            <Setter Property="CornerRadius" Value="{Binding SegmentRadius, Source={RelativeSource AncestorType={x:Type controls:LevelBar}}, x:DataType=controls:LevelBar}" />
            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LineStrongLight}, Dark={StaticResource LineStrongDark}}" />
            <Style.Triggers>
                <DataTrigger TargetType="BoxView" Binding="{Binding IsFilled, x:DataType=viewmodels:LevelSegment}" Value="True">
                    <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DisplaySegment" x:DataType="viewmodels:LevelSegment">
            <BoxView Style="{StaticResource LevelSegmentBar}"
                     FlexLayout.Grow="1"
                     FlexLayout.Basis="0"
                     Margin="{Binding SegmentInset, Source={RelativeSource AncestorType={x:Type controls:LevelBar}}, x:DataType=controls:LevelBar}" />
        </DataTemplate>

        <DataTemplate x:Key="TappableSegment" x:DataType="viewmodels:LevelSegment">
            <Grid FlexLayout.Grow="1"
                  FlexLayout.Basis="0"
                  Padding="{Binding SegmentInset, Source={RelativeSource AncestorType={x:Type controls:LevelBar}}, x:DataType=controls:LevelBar}"
                  HeightRequest="28"
                  BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCommand, Source={RelativeSource AncestorType={x:Type controls:LevelBar}}, x:DataType=controls:LevelBar}"
                                          CommandParameter="{Binding Value}" />
                </Grid.GestureRecognizers>
                <BoxView Style="{StaticResource LevelSegmentBar}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </ContentView.Resources>

    <FlexLayout x:Name="SegmentLayout"
                BindableLayout.ItemTemplate="{StaticResource DisplaySegment}"
                BindableLayout.ItemsSource="{Binding Segments, Source={x:Reference Root}}" />
</ContentView>
