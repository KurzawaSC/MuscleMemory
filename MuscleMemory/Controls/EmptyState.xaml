<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.EmptyState"
             x:Name="Root"
             x:DataType="controls:EmptyState">

    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
        <Image Source="{Binding IconSource, Source={x:Reference Root}}"
               IsVisible="{Binding HasIcon, Source={x:Reference Root}}"
               WidthRequest="80"
               HeightRequest="80"
               Opacity="0.3" />
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding Message, Source={x:Reference Root}}"
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Detail, Source={x:Reference Root}}"
                   IsVisible="{Binding HasDetail, Source={x:Reference Root}}"
                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
