<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.EmptyState"
             x:Name="Root"
             x:DataType="controls:EmptyState"
             Padding="40,0">

    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
        <VerticalStackLayout Spacing="6">
            <Label Style="{StaticResource TitleLabel}"
                   Text="{Binding Message, Source={x:Reference Root}}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Detail, Source={x:Reference Root}}"
                   IsVisible="{Binding HasDetail, Source={x:Reference Root}}"
                   TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <controls:TappableButton Style="{StaticResource PrimaryButton}"
                                 Text="{Binding ActionText, Source={x:Reference Root}}"
                                 Command="{Binding ActionCommand, Source={x:Reference Root}}"
                                 IsVisible="{Binding HasAction, Source={x:Reference Root}}"
                                 HorizontalOptions="Center"
                                 ContentPadding="24,0" />
    </VerticalStackLayout>
</ContentView>
