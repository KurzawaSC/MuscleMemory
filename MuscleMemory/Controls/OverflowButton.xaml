<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.OverflowButton"
             x:Name="Root"
             x:DataType="controls:OverflowButton"
             WidthRequest="{StaticResource TouchTarget}"
             HeightRequest="{StaticResource TouchTarget}"
             VerticalOptions="Start"
             Margin="0,-9,-9,0">

    <Grid BackgroundColor="Transparent">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Grid.GestureRecognizers>
        <Border WidthRequest="30"
                HeightRequest="30"
                StrokeThickness="0"
                InputTransparent="True"
                BackgroundColor="{AppThemeBinding Light={StaticResource FillLight}, Dark={StaticResource FillDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                <BoxView Style="{StaticResource OverflowDot}" />
                <BoxView Style="{StaticResource OverflowDot}" />
                <BoxView Style="{StaticResource OverflowDot}" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>
