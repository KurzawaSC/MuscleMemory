<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             xmlns:viewmodels="clr-namespace:MuscleMemory.ViewModels"
             xmlns:models="clr-namespace:MuscleMemory.Models"
             x:Class="MuscleMemory.Controls.ExercisePickerSheet"
             x:Name="Root"
             x:DataType="controls:ExercisePickerSheet">

    <VerticalStackLayout Spacing="14">
        <Grid ColumnDefinitions="*, Auto">
            <Label Style="{StaticResource TitleLabel}" Text="Select exercise" VerticalOptions="Center" />
            <controls:TappableButton Grid.Column="1"
                                     Style="{StaticResource NeutralTextButton}"
                                     Text="Close"
                                     FontSize="15"
                                     Command="{Binding CloseCommand, Source={x:Reference Root}}" />
        </Grid>

        <controls:TextField IsFilled="True"
                            Text="{Binding Picker.Filter.SearchText, Source={x:Reference Root}}"
                            Placeholder="Search"
                            ClearButtonVisibility="WhileEditing" />

        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8"
                                   RadioButtonGroup.GroupName="ExercisePickerFilters"
                                   RadioButtonGroup.SelectedValue="{Binding Picker.Filter.SelectedFilter, Source={x:Reference Root}}"
                                   BindableLayout.ItemsSource="{Binding Picker.Filter.Filters, Source={x:Reference Root}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MuscleGroupFilter">
                        <RadioButton Style="{StaticResource FilterChip}"
                                     Content="{Binding Label}"
                                     Value="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid>
            <CollectionView HeightRequest="{StaticResource ExercisePickerListHeight}"
                            ItemSizingStrategy="MeasureFirstItem"
                            ItemsSource="{Binding Picker.Exercises, Source={x:Reference Root}}">
                <CollectionView.Behaviors>
                    <controls:ScrollToTopOnInsertBehavior />
                </CollectionView.Behaviors>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Exercise">
                        <Border Padding="14,12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineStrongDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource ControlRadius}" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickCommand, Source={x:Reference Root}, x:DataType=controls:ExercisePickerSheet}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource CaptionLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="TargetMuscleGroup" Converter="{StaticResource EnumDisplayNameConverter}" />
                                                <Binding Path="Equipment" Converter="{StaticResource EnumDisplayNameConverter}" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="+"
                                           FontSize="17"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.FooterTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <Border Style="{StaticResource DashedOutline}"
                                Margin="0,8,0,0"
                                IsVisible="{Binding CanCreate, Source={x:Reference Root}, x:DataType=controls:ExercisePickerSheet}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CreateCommand, Source={x:Reference Root}, x:DataType=controls:ExercisePickerSheet}" />
                            </Border.GestureRecognizers>
                            <Label Text="Not on the list? Create a new one"
                                   TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
                                   HorizontalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.FooterTemplate>
            </CollectionView>

            <Label Text="No exercises match your search"
                   TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMutedDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   InputTransparent="True"
                   IsVisible="{Binding Picker.HasNoMatches, Source={x:Reference Root}}" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
