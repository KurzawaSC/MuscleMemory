<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.InputStepper"
             x:Name="Root"
             x:DataType="controls:InputStepper">

    <VerticalStackLayout Spacing="6">
        <Label Style="{StaticResource OverlineLabel}" Text="{Binding Title, Source={x:Reference Root}}" />
        <Border x:Name="Field" Style="{StaticResource InsetPanel}" Padding="0" HeightRequest="56" StrokeThickness="2" Stroke="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup>
                        <VisualState Name="{x:Static controls:FieldVisualStates.Idle}" />
                        <VisualState Name="{x:Static controls:FieldVisualStates.Invalid}">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLineLight}, Dark={StaticResource PrimaryLineDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="{x:Static controls:FieldVisualStates.Editing}">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:GlyphButton Glyph="−"
                                      Style="{StaticResource StepperGlyphButton}"
                                      SurfaceSize="30"
                                      IsVisible="{Binding HasValue, Source={x:Reference Root}}"
                                      Command="{Binding DecrementCommand, Source={x:Reference Root}}">
                    <controls:GlyphButton.Triggers>
                        <DataTrigger TargetType="controls:GlyphButton" Binding="{Binding IsFocused, Source={x:Reference ValueEntry}}" Value="True">
                            <Setter Property="FillColor" Value="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}" />
                            <Setter Property="GlyphColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </controls:GlyphButton.Triggers>
                </controls:GlyphButton>
                <Entry x:Name="ValueEntry"
                       Grid.Column="1"
                       Style="{StaticResource StepperEntry}"
                       Text="{Binding Text, Source={x:Reference Root}}"
                       MaxLength="{Binding MaxLength, Source={x:Reference Root}}"
                       SemanticProperties.Description="{Binding Description, Source={x:Reference Root}}"
                       Placeholder="—"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       Focused="OnValueEntryFocusChanged"
                       Unfocused="OnValueEntryFocusChanged" />
                <controls:GlyphButton Grid.Column="2"
                                      Glyph="+"
                                      Style="{StaticResource StepperGlyphButton}"
                                      SurfaceSize="30"
                                      IsVisible="{Binding HasValue, Source={x:Reference Root}}"
                                      Command="{Binding IncrementCommand, Source={x:Reference Root}}">
                    <controls:GlyphButton.Triggers>
                        <DataTrigger TargetType="controls:GlyphButton" Binding="{Binding IsFocused, Source={x:Reference ValueEntry}}" Value="True">
                            <Setter Property="FillColor" Value="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}" />
                            <Setter Property="GlyphColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </controls:GlyphButton.Triggers>
                </controls:GlyphButton>
            </Grid>
        </Border>
        <Label Style="{StaticResource CaptionLabel}"
               Text="{Binding ErrorText, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
               IsVisible="{Binding HasError, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
