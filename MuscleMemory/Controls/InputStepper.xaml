<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.InputStepper"
             x:Name="Root"
             x:DataType="controls:InputStepper">

    <VerticalStackLayout Spacing="6">
        <Label Style="{StaticResource OverlineLabel}" Text="{Binding Title, Source={x:Reference Root}}" />
        <Border Style="{StaticResource InsetPanel}" Padding="0" HeightRequest="56" StrokeThickness="2" Stroke="Transparent">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsFocused, Source={x:Reference ValueEntry}}" Value="True">
                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:GlyphButton Glyph="−"
                                      Style="{StaticResource StepperGlyphButton}"
                                      SurfaceSize="30"
                                      IsVisible="{Binding HasValue, Source={x:Reference Root}}"
                                      Command="{Binding DecrementCommand, Source={x:Reference Root}}">
                    <controls:GlyphButton.Triggers>
                        <DataTrigger TargetType="controls:GlyphButton" Binding="{Binding IsFocused, Source={x:Reference ValueEntry}}" Value="True">
                            <Setter Property="FillColor" Value="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}" />
                            <Setter Property="GlyphColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </controls:GlyphButton.Triggers>
                </controls:GlyphButton>
                <Entry x:Name="ValueEntry"
                       Grid.Column="1"
                       Text="{Binding Text, Source={x:Reference Root}}"
                       Placeholder="—"
                       Keyboard="Numeric"
                       FontSize="24"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <controls:GlyphButton Grid.Column="2"
                                      Glyph="+"
                                      Style="{StaticResource StepperGlyphButton}"
                                      SurfaceSize="30"
                                      IsVisible="{Binding HasValue, Source={x:Reference Root}}"
                                      Command="{Binding IncrementCommand, Source={x:Reference Root}}">
                    <controls:GlyphButton.Triggers>
                        <DataTrigger TargetType="controls:GlyphButton" Binding="{Binding IsFocused, Source={x:Reference ValueEntry}}" Value="True">
                            <Setter Property="FillColor" Value="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}" />
                            <Setter Property="GlyphColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </DataTrigger>
                    </controls:GlyphButton.Triggers>
                </controls:GlyphButton>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
