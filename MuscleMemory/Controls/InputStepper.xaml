<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MuscleMemory.Controls"
             x:Class="MuscleMemory.Controls.InputStepper"
             x:Name="Root"
             x:DataType="controls:InputStepper">

    <VerticalStackLayout Spacing="6">
        <Label Style="{StaticResource OverlineLabel}" Text="{Binding Title, Source={x:Reference Root}}" />
        <Border Style="{StaticResource InsetPanel}" Padding="0" HeightRequest="56">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:GlyphButton Glyph="−"
                                      Style="{StaticResource StepperGlyphButton}"
                                      SurfaceSize="30"
                                      Command="{Binding DecrementCommand, Source={x:Reference Root}}" />
                <Entry Grid.Column="1"
                       Text="{Binding Text, Source={x:Reference Root}}"
                       Placeholder="—"
                       Keyboard="Numeric"
                       FontSize="24"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <controls:GlyphButton Grid.Column="2"
                                      Glyph="+"
                                      Style="{StaticResource StepperGlyphButton}"
                                      SurfaceSize="30"
                                      Command="{Binding IncrementCommand, Source={x:Reference Root}}" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
