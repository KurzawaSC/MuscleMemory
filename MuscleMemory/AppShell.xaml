<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MuscleMemory.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MuscleMemory.Views"
    xmlns:constants="clr-namespace:MuscleMemory.Constants"
    xmlns:strings="clr-namespace:MuscleMemory.Resources.Strings"
    Shell.FlyoutBehavior="Disabled"
    Title="{x:Static strings:AppResources.AppName}">

    <TabBar>

        <Tab Title="{x:Static strings:AppResources.HeaderExercises}" Icon="exercise_list_icon.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:ExerciseListPage}"
                Route="{x:Static constants:NavigationRoutes.ExerciseTab}" />
        </Tab>

        <Tab Title="{x:Static strings:AppResources.HeaderWorkouts}" Icon="workout_list_icon.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:WorkoutListPage}"
                Route="{x:Static constants:NavigationRoutes.WorkoutTab}" />
        </Tab>

        <Tab Title="{x:Static strings:AppResources.HeaderSettings}" Icon="settings_icon.png">
            <ShellContent
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="{x:Static constants:NavigationRoutes.SettingsTab}" />
        </Tab>

    </TabBar>

</Shell>
