<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>

		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
		<RootNamespace>MuscleMemory</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<NeutralLanguage>en</NeutralLanguage>

		<ApplicationTitle>Muscle Memory</ApplicationTitle>

		<ApplicationId>io.github.kurzawasc.musclememory</ApplicationId>

		<ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>
		<Version>$(ApplicationDisplayVersion)</Version>
		<ApplicationVersion>3</ApplicationVersion>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\logo.png" />

		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FF4040" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />

		<MauiFont Include="Resources\Fonts\*.ttf" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<EmbeddedResource Update="Resources\Strings\AppResources.resx"
		                  StronglyTypedLanguage="CSharp"
		                  StronglyTypedNamespace="MuscleMemory.Resources.Strings"
		                  StronglyTypedClassName="AppResources"
		                  StronglyTypedFileName="$(IntermediateOutputPath)AppResources.g.cs" />
	</ItemGroup>

	<ItemGroup>
		<MauiPlatformSpecificFolder Include="Platforms\Net\" Condition="'$(TargetPlatformIdentifier)' == ''" />
		<InternalsVisibleTo Include="MuscleMemory.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<PackageReference Include="sqlite-net-e" Version="1.11.285" />
		<PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
		<PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
		<PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
		<PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
	</ItemGroup>

	<Target Name="GenerateResourceAccessorAtDesignTime"
	        BeforeTargets="CoreCompile"
	        DependsOnTargets="PrepareResourceNames;CoreResGen"
	        Condition="'$(DesignTimeBuild)' == 'true'" />

	<Target Name="AddSatelliteLanguagesMetadata" BeforeTargets="GetAssemblyAttributes">
		<AssignCulture Files="@(EmbeddedResource)">
			<Output TaskParameter="AssignedFilesWithCulture" ItemName="_LocalizedEmbeddedResource" />
		</AssignCulture>
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>SatelliteLanguages</_Parameter1>
				<_Parameter2>@(_LocalizedEmbeddedResource->'%(Culture)'->Distinct())</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

</Project>
